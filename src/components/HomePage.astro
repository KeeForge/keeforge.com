---
import Base from '../layouts/Base.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { home } from '../i18n/home';

interface Props {
    lang: 'en' | 'de' | 'fr' | 'es';
}

const { lang } = Astro.props;
const t = home[lang];
---

<Base title={t.title} description={t.description} lang={lang} enPath={home.en.path} dePath={home.de.path} frPath={home.fr.path} esPath={home.es.path}>
    <div class="kf-root">
        <!-- Nav -->
        <header class="kf-nav">
            <div class="kf-nav-inner">
                <a href={t.path} class="kf-brand">
                    <span class="kf-keymark" aria-hidden="true"></span>
                    <span class="kf-brand-name">KeeForge</span>
                </a>
                <nav class="kf-nav-links">
                    <a href="#features">{t.nav.features}</a>
                    <a href="#faq">{t.nav.faq}</a>
                    <a href="https://github.com/crazytan/KeeForge/blob/main/CHANGELOG.md" rel="noopener">{t.nav.changelog}</a>
                </nav>
                <div class="kf-nav-cta">
                    <LanguageSwitcher
                        current={lang}
                        paths={{ en: home.en.path, de: home.de.path, fr: home.fr.path, es: home.es.path }}
                        variant="header"
                    />
                    <a href="https://github.com/crazytan/KeeForge" rel="noopener" class="kf-nav-source">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                        <span>{t.nav.source}</span>
                    </a>
                    <a href="https://apps.apple.com/us/app/keeforge/id6759309295" class="kf-btn kf-btn-pill">
                        <svg viewBox="0 0 17 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14.83 6.42c-.1.08-1.92 1.1-1.92 3.38 0 2.64 2.31 3.57 2.38 3.6-.01.06-.37 1.28-1.22 2.52-.76 1.1-1.55 2.19-2.75 2.19-1.2 0-1.51-.7-2.9-.7-1.35 0-1.83.73-2.93.73-1.1 0-1.87-1.01-2.75-2.26C1.7 13.93 1 11.59 1 9.38c0-3.54 2.3-5.42 4.57-5.42 1.2 0 2.21.79 2.96.79.72 0 1.84-.84 3.22-.84.52 0 2.34.05 3.08 2.51zM10.65 2.35c.57-.68.97-1.62.97-2.56 0-.13-.01-.26-.03-.37-.93.04-2.03.62-2.7 1.4-.52.6-1 1.55-1 2.5 0 .14.02.29.03.34.06.01.16.02.26.02.83 0 1.88-.56 2.47-1.33z"/></svg>
                        App Store
                    </a>
                </div>
            </div>
        </header>

        <!-- Hero -->
        <section class="kf-hero">
            <div class="kf-flourish" data-parallax="0.04" aria-hidden="true">✱</div>
            <div class="kf-hero-grid">
                <div class="kf-hero-copy">
                    <h1 data-reveal data-reveal-delay="80" set:html={t.hero.h1}></h1>
                    <p class="kf-hero-lead" data-reveal data-reveal-delay="160" set:html={t.hero.lead}></p>
                    <div class="kf-hero-cta" data-reveal data-reveal-delay="220">
                        <a href="https://apps.apple.com/us/app/keeforge/id6759309295" class="kf-btn kf-btn-appstore">
                            <svg viewBox="0 0 17 20" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M14.83 6.42c-.1.08-1.92 1.1-1.92 3.38 0 2.64 2.31 3.57 2.38 3.6-.01.06-.37 1.28-1.22 2.52-.76 1.1-1.55 2.19-2.75 2.19-1.2 0-1.51-.7-2.9-.7-1.35 0-1.83.73-2.93.73-1.1 0-1.87-1.01-2.75-2.26C1.7 13.93 1 11.59 1 9.38c0-3.54 2.3-5.42 4.57-5.42 1.2 0 2.21.79 2.96.79.72 0 1.84-.84 3.22-.84.52 0 2.34.05 3.08 2.51zM10.65 2.35c.57-.68.97-1.62.97-2.56 0-.13-.01-.26-.03-.37-.93.04-2.03.62-2.7 1.4-.52.6-1 1.55-1 2.5 0 .14.02.29.03.34.06.01.16.02.26.02.83 0 1.88-.56 2.47-1.33z"/></svg>
                            <span class="kf-btn-stack">
                                <span class="kf-btn-tiny">{t.hero.downloadTiny}</span>
                                <span class="kf-btn-big">{t.hero.downloadBig}</span>
                            </span>
                        </a>
                        <a href="https://github.com/crazytan/KeeForge" rel="noopener" class="kf-btn kf-btn-ghost">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                            {t.hero.readSource}
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                        </a>
                    </div>
                    <div class="kf-hero-meta" data-reveal data-reveal-delay="280">
                        {t.hero.meta.map((m, i) => (
                            <>
                                {i > 0 && <span class="kf-dot"></span>}
                                <span set:html={m}></span>
                            </>
                        ))}
                    </div>
                </div>
                <div class="kf-hero-phone-wrap" data-parallax="0.08">
                    <div class="kf-hero-halo" aria-hidden="true"></div>
                    <div data-reveal data-reveal-y="40" data-reveal-delay="100">
                        <div class="kf-phone kf-phone-hero">
                            <div class="kf-phone-screen">
                                <img src="/screenshots/screen-01-database-list.png" alt={t.hero.screenshotAlt} width="320" height="693" />
                                <span class="kf-phone-island"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust -->
        <section class="kf-trust">
            <div class="kf-trust-grid">
                {t.trustPills.map((p, i) => (
                    <div class="kf-trust-cell" data-reveal data-reveal-delay={i * 80} data-reveal-y="20">
                        <div class="kf-trust-k mono">{p.k}</div>
                        <div class="kf-trust-t">{p.t}</div>
                        <div class="kf-trust-d">{p.d}</div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Features -->
        {t.features.map((f, i) => (
            <section class={`kf-feature${f.reverse ? ' kf-feature-reverse' : ''}`} id={i === 0 ? 'features' : undefined}>
                <div class="kf-feature-grid">
                    <div class="kf-feature-copy">
                        <div class="kf-eyebrow mono" data-reveal>{String(i + 1).padStart(2, '0')} · {f.eyebrow}</div>
                        <h2 data-reveal data-reveal-delay="80">{f.title}</h2>
                        <p data-reveal data-reveal-delay="140">{f.body}</p>
                        <ul data-reveal data-reveal-delay="200">
                            {f.points.map((p) => (
                                <li><span class="kf-dash"></span>{p}</li>
                            ))}
                        </ul>
                    </div>
                    <div class="kf-feature-phone-wrap">
                        <div data-reveal data-reveal-y="40" data-reveal-delay="100">
                            <div class="kf-feature-phone-bg" data-reveal-bg></div>
                            <div class="kf-phone kf-phone-feature">
                                <div class="kf-phone-screen">
                                    <img src={`/screenshots/${f.screen}`} alt="" width="280" height="606" loading="lazy" />
                                    <span class="kf-phone-island"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ))}

        <!-- Data safety -->
        <section class="kf-safety" id="safety">
            <div class="kf-safety-grid">
                <div class="kf-safety-head">
                    <div class="kf-eyebrow mono" data-reveal>{t.safety.eyebrow}</div>
                    <h2 data-reveal data-reveal-delay="80" set:html={t.safety.h2}></h2>
                    <p data-reveal data-reveal-delay="140">{t.safety.lead}</p>
                    <a href={t.safety.linkHref} rel="noopener" class="kf-safety-link" data-reveal data-reveal-delay="200">
                        {t.safety.linkLabel}
                        <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                    </a>
                </div>
                <div class="kf-safety-list">
                    {t.safety.items.map((item, i) => (
                        <div class="kf-safety-item" data-reveal data-reveal-delay={i * 80}>
                            <h3>{item.title}</h3>
                            <p>{item.body}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Compare -->
        <section class="kf-compare">
            <div class="kf-compare-head">
                <div class="kf-eyebrow mono" data-reveal>{t.compare.eyebrow}</div>
                <h2 data-reveal data-reveal-delay="80" set:html={t.compare.h2}></h2>
            </div>
            <div class="kf-compare-grid">
                {t.compare.cards.map((c, i) => (
                    <article class="kf-compare-card" data-reveal data-reveal-delay={i * 100} data-reveal-y="32">
                        <div class="kf-compare-num mono">{String(i + 1).padStart(2, '0')} / 03</div>
                        <h3>{c.title}</h3>
                        <ul>
                            {c.bullets.map((b) => (
                                <li>
                                    <span class="kf-bullet-dot"></span>
                                    <div set:html={b}></div>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
        </section>

        <!-- Public beta -->
        <section class="kf-beta" id="beta">
            <div class="kf-beta-grid">
                <div class="kf-beta-copy">
                    <div class="kf-eyebrow mono" data-reveal>{t.beta.eyebrow}</div>
                    <h2 data-reveal data-reveal-delay="80" set:html={t.beta.h2}></h2>
                    <p data-reveal data-reveal-delay="140">{t.beta.body}</p>
                    <div class="kf-beta-cta" data-reveal data-reveal-delay="200">
                        <a href={t.beta.href} rel="noopener" class="kf-btn kf-btn-gold">
                            {t.beta.cta}
                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                        </a>
                    </div>
                    <p class="kf-beta-availability" data-reveal data-reveal-delay="260">{t.beta.availability}</p>
                </div>
                <aside class="kf-beta-warn" role="note" data-reveal data-reveal-y="30" data-reveal-delay="120">
                    <p class="kf-beta-warn-title">{t.beta.warningTitle}</p>
                    <p class="kf-beta-warn-body">{t.beta.warningBody}</p>
                </aside>
            </div>
        </section>

        <!-- FAQ -->
        <section class="kf-faq" id="faq">
            <div class="kf-faq-grid">
                <div class="kf-faq-head">
                    <div class="kf-eyebrow mono" data-reveal>{t.faq.eyebrow}</div>
                    <h2 data-reveal data-reveal-delay="80" set:html={t.faq.h2}></h2>
                </div>
                <div class="kf-faq-list">
                    {t.faq.items.map((item, i) => (
                        <div class="kf-faq-item" data-reveal data-reveal-delay={i * 60}>
                            <button class="kf-faq-q" type="button" aria-expanded="false">
                                <h3>{item.q}</h3>
                                <span class="kf-faq-plus" aria-hidden="true">+</span>
                            </button>
                            <div class="kf-faq-a">
                                <p>{item.a}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="kf-foot">
            <div class="kf-foot-inner">
                <div class="kf-foot-brand">
                    <span class="kf-keymark kf-keymark-sm" aria-hidden="true"></span>
                    <span class="kf-foot-name">KeeForge</span>
                    <span class="kf-foot-copy">{t.footer.copy}</span>
                </div>
                <div class="kf-foot-links">
                    <a href={t.footer.privacyHref}>{t.footer.privacy}</a>
                    <a href="mailto:support@keeforge.com">{t.footer.support}</a>
                    <LanguageSwitcher
                        current={lang}
                        paths={{ en: home.en.path, de: home.de.path, fr: home.fr.path, es: home.es.path }}
                        variant="footer"
                    />
                </div>
            </div>
        </footer>
    </div>
</Base>

<style is:global>
    body { background: #F2EADA; }
    html { scroll-behavior: smooth; }
</style>
<noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>

<style>
    .kf-root {
        --kf-bg: #F2EADA;
        --kf-bg-alt: #E9DFC8;
        --kf-paper: #FBF5E7;
        --kf-ink: #26201A;
        --kf-ink-soft: #5C5044;
        --kf-ink-mute: #8A7C6B;
        --kf-rule: #D8CCB1;
        --kf-gold: #D8A03C;
        --kf-navy: #3A4479;
        --kf-accent: #BD5A3A;
        --kf-accent-deep: #8E3F25;
        --kf-serif: 'Newsreader', Georgia, serif;
        --kf-sans: 'Instrument Sans', system-ui, -apple-system, sans-serif;
        --kf-mono: 'JetBrains Mono', ui-monospace, monospace;
        background: var(--kf-bg);
        color: var(--kf-ink);
        font-family: var(--kf-sans);
        min-height: 100vh;
        font-feature-settings: "ss01", "ss02";
    }

    .kf-root .mono { font-family: var(--kf-mono); }
    .kf-root code { font-family: var(--kf-mono); }

    [data-reveal] {
        opacity: 0;
        transform: translateY(26px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }
    [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Key mark ────────────────────────────────────────────────────── */
    .kf-keymark {
        width: 34px; height: 34px;
        border-radius: 8px;
        background: var(--kf-navy);
        display: inline-block;
        position: relative;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
        flex-shrink: 0;
    }
    .kf-keymark::after {
        content: "";
        position: absolute;
        inset: 11%;
        background: var(--kf-gold);
        -webkit-mask: url("/keeforge-key.svg") center/contain no-repeat;
        mask: url("/keeforge-key.svg") center/contain no-repeat;
    }
    .kf-keymark-sm { width: 22px; height: 22px; border-radius: 6px; }

    /* ── Nav ─────────────────────────────────────────────────────────── */
    .kf-nav {
        position: sticky; top: 0; z-index: 50;
        background: rgba(242, 234, 218, 0.9);
        backdrop-filter: saturate(1.4) blur(14px);
        -webkit-backdrop-filter: saturate(1.4) blur(14px);
        border-bottom: 1px solid var(--kf-rule);
        padding: 18px clamp(24px, 5vw, 56px);
    }
    .kf-nav-inner {
        max-width: 1280px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px;
    }
    .kf-brand {
        display: inline-flex; align-items: center; gap: 10px;
        text-decoration: none; color: var(--kf-ink);
    }
    .kf-brand-name {
        font-family: var(--kf-serif);
        font-size: 22px; font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--kf-ink);
    }
    .kf-nav-links {
        display: flex; align-items: center; gap: 32px;
        font-size: 14.5px; color: var(--kf-ink-soft);
    }
    .kf-nav-links a {
        color: inherit; text-decoration: none; transition: color 0.2s;
    }
    .kf-nav-links a:hover { color: var(--kf-ink); }
    .kf-nav-cta {
        display: flex; align-items: center; gap: 12px; font-size: 14.5px;
    }
    .kf-nav-source {
        display: inline-flex; align-items: center; gap: 8px;
        color: var(--kf-ink-soft); text-decoration: none; transition: color 0.2s;
    }
    .kf-nav-source:hover { color: var(--kf-ink); }

    /* ── Buttons ─────────────────────────────────────────────────────── */
    .kf-btn {
        display: inline-flex; align-items: center; gap: 10px;
        border-radius: 999px; border: none; cursor: pointer;
        font-family: var(--kf-sans); font-weight: 500;
        text-decoration: none;
        transition: transform 0.2s, background 0.2s, color 0.2s;
    }
    .kf-btn-pill {
        padding: 10px 18px; gap: 8px;
        background: var(--kf-ink); color: var(--kf-paper);
        font-size: 14.5px;
    }
    .kf-btn-pill:hover { transform: translateY(-1px); }
    .kf-btn-appstore {
        padding: 16px 24px;
        background: var(--kf-ink); color: var(--kf-paper);
        font-size: 16px;
    }
    .kf-btn-appstore:hover { transform: translateY(-2px); }
    .kf-btn-stack { display: inline-flex; flex-direction: column; gap: 3px; align-items: flex-start; line-height: 1; }
    .kf-btn-tiny { font-size: 10.5px; opacity: 0.7; font-weight: 400; }
    .kf-btn-big { font-size: 17px; }
    .kf-btn-ghost {
        padding: 16px 22px;
        background: transparent; color: var(--kf-ink);
        border: 1.5px solid var(--kf-ink);
        font-size: 15px;
    }
    .kf-btn-ghost:hover { background: var(--kf-ink); color: var(--kf-paper); }
    .kf-btn-gold {
        padding: 14px 22px;
        background: var(--kf-gold); color: var(--kf-ink);
        font-size: 15px;
    }
    .kf-btn-gold:hover { transform: translateY(-1px); }

    /* ── Hero ────────────────────────────────────────────────────────── */
    .kf-hero {
        position: relative;
        padding: 84px clamp(24px, 5vw, 56px) 100px;
        overflow: hidden;
        max-width: 1280px;
        margin: 0 auto;
    }
    .kf-flourish {
        position: absolute; top: 30px; right: 60px;
        font-family: var(--kf-serif); font-style: italic;
        font-size: 340px; line-height: 1;
        color: var(--kf-accent); opacity: 0.06;
        pointer-events: none;
        transition: transform 0.1s linear;
        will-change: transform;
    }
    .kf-hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 60px;
        align-items: center;
    }
    .kf-hero h1 {
        margin: 0;
        font-family: var(--kf-serif);
        font-weight: 500;
        font-size: clamp(54px, 7vw, 88px);
        line-height: 1.02;
        letter-spacing: -0.025em;
        color: var(--kf-ink);
        text-wrap: balance;
    }
    .kf-hero h1 em {
        font-style: italic;
        color: var(--kf-accent);
        font-family: var(--kf-serif);
    }
    .kf-hero-lead {
        margin: 28px 0 0; max-width: 520px;
        font-size: 19px; line-height: 1.55;
        color: var(--kf-ink-soft);
        text-wrap: pretty;
    }
    .kf-hero-lead code {
        font-size: 16.5px;
        background: var(--kf-bg-alt);
        padding: 1px 6px;
        border-radius: 4px;
    }
    .kf-hero-cta {
        display: flex; align-items: center; gap: 14px;
        margin-top: 36px; flex-wrap: wrap;
    }
    .kf-hero-meta {
        margin-top: 38px;
        display: flex; align-items: center; gap: 28px;
        font-size: 13.5px; color: var(--kf-ink-mute);
        flex-wrap: wrap;
    }
    .kf-dot {
        width: 3px; height: 3px; border-radius: 999px;
        background: var(--kf-ink-mute);
    }
    .kf-hero-phone-wrap {
        position: relative;
        display: flex; justify-content: center;
        transition: transform 0.1s linear;
        will-change: transform;
    }
    .kf-hero-halo {
        position: absolute;
        width: 460px; height: 460px; border-radius: 50%;
