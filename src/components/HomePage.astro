---
import Base from '../layouts/Base.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ProductScreenshots from './ProductScreenshots.astro';
import DownloadLinks from './DownloadLinks.astro';
import { home } from '../i18n/home';
import type { LocaleCode } from '../i18n/locales';
import '../styles/home.css';

interface Props { lang: LocaleCode; }
const { lang } = Astro.props;
const t = home[lang];
const paths = { en: home.en.path, de: home.de.path, fr: home.fr.path, es: home.es.path,
    'zh-hans': home['zh-hans'].path, 'zh-hant': home['zh-hant'].path, ja: home.ja.path, it: home.it.path };
const source = 'https://github.com/KeeForge/KeeForge';
---
<Base title={t.title} description={t.description} lang={lang} canonicalPath={t.path}
    enPath={paths.en} dePath={paths.de} frPath={paths.fr} esPath={paths.es}
    zhHansPath={paths['zh-hans']} zhHantPath={paths['zh-hant']} jaPath={paths.ja} itPath={paths.it}>
    <div class="kf-home">
        <a href="#main" class="skip">{t.nav.skip}</a>
        <header class="nav">
            <div class="wrap nav-inner">
                <a class="brand" href={t.path}><span class="key" aria-hidden="true"></span>KeeForge</a>
                <nav class="navlinks" aria-label={t.nav.menu}>
                    <a href="#features">{t.nav.features}</a>
                    <a href="#faq">{t.nav.faq}</a>
                    <a href={`${source}/blob/main/CHANGELOG.md`}>{t.nav.changelog}</a>
                    <a href="/security-audit/">{t.nav.audit}</a>
                </nav>
                <div class="navright">
                    <div class="header-language"><LanguageSwitcher current={lang} paths={paths} variant="header" /></div>
                    <a class="nav-source" href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                    <a class="btn small" href="#download">{t.nav.download}</a>
                    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">{t.nav.menu}</button>
                </div>
            </div>
            <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.menu} hidden>
                <a href="#features">{t.nav.features}</a>
                <a href="#compare">{t.compare.eyebrow}</a>
                <a href="#beta">{t.beta.eyebrow}</a>
                <a href="#faq">{t.nav.faq}</a>
                <a href={`${source}/blob/main/CHANGELOG.md`}>{t.nav.changelog}</a>
                <a href="/security-audit/">{t.nav.audit}</a>
                <a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                <div class="mobile-languages"><LanguageSwitcher current={lang} paths={paths} variant="footer" /></div>
            </nav>
        </header>
        <main id="main">
            <section class="hero wrap">
                <div class="hero-copy">
                    <h1 set:html={t.hero.h1}></h1>
                    <p class="lead" set:html={t.hero.lead}></p>
                    <DownloadLinks labels={t.downloads} id="download" />
                </div>
                <ProductScreenshots phoneSrc="/screenshots/screen-01-database-list.png" phoneAlt={t.screenshots.iosAlt}
                    macAlt={t.screenshots.macAlt} />
            </section>
            <section class="trust">
                <div class="wrap trust-grid">
                    {t.trustPills.map((pill) => <div class="trust-item">
                        <div class="eyebrow">{pill.k}</div><h3>{pill.t}</h3><p>{pill.d}</p>
                    </div>)}
                </div>
            </section>
            {t.features.map((feature, i) => (
                <section class:list={['feature-section', { alternate: i === 1 }]} id={i === 0 ? 'features' : undefined}>
                    <div class:list={['wrap', 'feature-grid', { reverse: i === 1 }]}>
                        <div class="feature-copy">
                            <div class="eyebrow">{String(i + 1).padStart(2, '0')} · {feature.eyebrow}</div>
                            <h2 class="line-breaks">{feature.title}</h2>
                            <p>{feature.body}</p>
                            <ul class="points">{feature.points.map(point => <li>{point}</li>)}</ul>
                            {i < 2 && <div class="platform-notes">
                                <p><strong>iPhone &amp; iPad</strong>{feature.iosNote}</p>
                                <p><strong>Mac</strong>{feature.macNote}</p>
                            </div>}
                        </div>
                        <ProductScreenshots
                            phoneSrc={`/screenshots/${['screen-01-database-list.png', 'screen-03-vault-groups.png', 'screen-07-entry-edit.png'][i]}`}
                            phoneAlt={[t.screenshots.iosAlt, t.screenshots.groupsAlt, t.screenshots.iosEditAlt][i]}
                            macSrc={i === 2 ? '/screenshots/mac-entry-edit.jpg' : undefined}
                            macWidth={i === 2 ? 1000 : undefined} macHeight={i === 2 ? 648 : undefined}
                            macAlt={i === 2 ? t.screenshots.editAlt : t.screenshots.macAlt} feature phoneLeft={i !== 1} />
                    </div>
                </section>
            ))}
            <section class="everyday">
                <div class="wrap everyday-grid">
                    <div><div class="eyebrow">{t.everyday.eyebrow}</div><h2 class="line-breaks">{t.everyday.title}</h2><p>{t.everyday.body}</p></div>
                    <dl>{t.everyday.items.map(item => <div><dt>{item.title}</dt><dd>{item.body}</dd></div>)}</dl>
                </div>
            </section>
            <section class="safety" id="safety">
                <div class="wrap safety-grid">
                    <div><div class="eyebrow">{t.safety.eyebrow}</div><h2 class="line-breaks">{t.safety.h2}</h2><p>{t.safety.lead}</p>
                        <a class="source" href={t.safety.linkHref}>{t.safety.linkLabel} <span aria-hidden="true">↗</span></a>
                    </div>
                    <div class="safety-list">{t.safety.items.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
                </div>
            </section>
            <section class="compare wrap" id="compare">
                <div class="section-heading"><div class="eyebrow">{t.compare.eyebrow}</div><h2 set:html={t.compare.h2}></h2></div>
                <div class="compare-grid">{t.compare.cards.map((card, i) => <article>
                    <div class="eyebrow">{String(i + 1).padStart(2, '0')} / 03</div><h3>{card.title}</h3>
                    <ul class="points">{card.bullets.map(bullet => <li>{bullet}</li>)}</ul>
                </article>)}</div>
                <div class="compare-links">
                    <a href={`${t.path}vs/keepassium/`}>KeeForge / KeePassium <span aria-hidden="true">↗</span></a>
                    <a href={`${t.path}vs/strongbox/`}>KeeForge / Strongbox <span aria-hidden="true">↗</span></a>
                </div>
            </section>
            <section class="beta" id="beta">
                <div class="wrap beta-grid">
                    <div><div class="eyebrow">{t.beta.eyebrow}</div><h2 set:html={t.beta.h2}></h2><p>{t.beta.body}</p>
                        <div class="beta-actions">
                            <a class="btn gold" href="https://testflight.apple.com/join/mPAT4f1a">{t.beta.cta} <span aria-hidden="true">↗</span></a>
                        </div>
                        <p class="small-copy">{t.beta.availability}</p>
                    </div>
                    <aside class="beta-warning"><h3>{t.beta.warningTitle}</h3><p>{t.beta.warningBody}</p></aside>
                </div>
            </section>
            <section class="faq wrap" id="faq">
                <div><h2>{t.nav.faq}</h2></div>
                <div>{t.faq.items.map(item => <details>
                    <summary>{item.q}<span aria-hidden="true" class="faq-symbol"></span></summary>
                    <div class="answer"><p>{item.a}</p></div>
                </details>)}</div>
            </section>
        </main>
        <footer class="foot">
            <div class="wrap">
                <div class="footer-top">
                    <a href={t.path} class="brand"><span class="key" aria-hidden="true"></span>KeeForge</a>
                    <nav><a href={t.footer.privacyHref}>{t.footer.privacy}</a>
                        <a href="mailto:support@keeforge.com">{t.footer.support}</a><a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a></nav>
                </div>
                <div class="footer-bottom"><span>{t.footer.copy}</span><LanguageSwitcher current={lang} paths={paths} variant="footer" /></div>
            </div>
        </footer>
    </div>
</Base>
<script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('mobile-nav');
    if (toggle && menu) {
        const closeMenu = () => { toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; };
        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!expanded));
            menu.hidden = expanded;
        });
        menu.addEventListener('click', event => {
            if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !menu.hidden) { closeMenu(); toggle.focus(); }
        });
        matchMedia('(min-width: 1101px)').addEventListener('change', closeMenu);
    }
</script>
