---
import type { home } from '../i18n/home';
interface Props {
    labels: typeof home.en.downloads;
    id?: string;
    requirements?: boolean;
}
const { labels, id, requirements = true } = Astro.props;
const appStore = 'https://apps.apple.com/us/app/keeforge/id6759309295';
---
<div class="downloads" id={id}>
    <div class="download">
        <a class="btn" href={`${appStore}?platform=iphone`}>{labels.ios}</a>
        {requirements && <small>{labels.iosRequirement}</small>}
    </div>
    <div class="download">
        <a class="btn" href={`${appStore}?platform=mac`}>{labels.mac}</a>
        {requirements && <small>{labels.macRequirement}</small>}
        <a class="direct" href="https://github.com/KeeForge/KeeForge/releases/latest">{labels.direct} <span aria-hidden="true">↗</span></a>
    </div>
</div>
