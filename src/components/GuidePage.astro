---
// The "best KeePass app for iPhone" guide, rendered in any locale from
// src/i18n/guide/<locale>.json.
import Page from '../layouts/Page.astro';
import DownloadLinks from './DownloadLinks.astro';
import { home } from '../i18n/home';
import { guide, guideApps, guideRivals, guidePath, guideLocales, sourceLinks, verdictOk } from '../i18n/guide';
import type { LocaleCode } from '../i18n/locales';

interface Props { lang: LocaleCode; }
const { lang } = Astro.props;
const g = guide[lang];
const prefix = lang === 'en' ? '/' : `/${lang}/`;
const path = guidePath(lang);
const sourceLabels: Record<string, string[]> = g.sources;
const alt = (code: LocaleCode) => (guideLocales.includes(code) ? guidePath(code) : undefined);

// Lets narrow screens wrap app names between their words, never mid-word.
const wrapName = (name: string) => name.replace(/([a-z])([A-Z])/g, '$1<wbr>$2').replace('Strongbox', 'Strong<wbr>box');
---

<Page
    lang={lang}
    enPath={alt('en')}
    dePath={alt('de')}
    frPath={alt('fr')}
    esPath={alt('es')}
    zhHansPath={alt('zh-hans')}
    zhHantPath={alt('zh-hant')}
    jaPath={alt('ja')}
    itPath={alt('it')}
    ruPath={alt('ru')}
    canonicalPath={path}
    ogType="article"
    title={g.title}
    description={g.description}
    eyebrow={g.eyebrow}
    heading={g.heading}
    headingAccent={g.headingAccent}
    lead={g.lead}
>
    <div class="verdict-hero" slot="hero">
        <ul class="strengths">
            {g.strengths.map((item) => <li>{item}</li>)}
        </ul>
        <DownloadLinks labels={home[lang].downloads} id="download" />
    </div>

    <section class="verdict" aria-labelledby="verdict-title">
        <h2 id="verdict-title">{g.verdictTitle}</h2>
        <div class="verdict-wrap">
            <table class="verdict-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">{g.feature}</span></th>
                        <th scope="col" class="us"><Fragment set:html={wrapName('KeeForge')} /></th>
                        {guideRivals.map((rival) => <th scope="col"><Fragment set:html={wrapName(rival)} /></th>)}
                    </tr>
                </thead>
                <tbody>
                    {g.verdict.map((row, i) => (
                        <tr>
                            <th scope="row">{row.label}</th>
                            <td class="us"><span class="mark yes" aria-label={g.yes}>✓</span><span class="note">{row.keeforge}</span></td>
                            {row.rivals.map((note, j) => (
                                <td><span class={`mark ${verdictOk[i][j] ? 'yes' : 'no'}`} aria-label={verdictOk[i][j] ? g.yes : g.no}>{verdictOk[i][j] ? '✓' : '✕'}</span><span class="note">{note}</span></td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="details" id="details">
        <details>
            <summary>{g.detailsSummary} <span aria-hidden="true" class="faq-symbol"></span></summary>
            <div class="details-body">
                <h3>{g.fullTableTitle}</h3>
                <div class="vs-table-wrap" tabindex="0" role="region" aria-label={g.fullTableLabel}>
                    <table class="vs-table wide">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">{g.feature}</span></th>
                                {guideApps.map((app) => <th scope="col">{app}</th>)}
                            </tr>
                        </thead>
                        <tbody>
                            {g.rows.map((row) => (
                                <tr>
                                    <th scope="row">{row.label}</th>
                                    {row.cells.map((cell) => <td>{cell}</td>)}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>

                <h3>{g.keepassxcTitle}</h3>
                <p>{g.keepassxcBody}</p>

                <h3 id="sources">{g.sourcesTitle}</h3>
                <p>{g.sourcesNote}</p>
                <div class="sources">
                    {Object.entries(sourceLinks).map(([app, hrefs]) => (
                        <div>
                            <h4>{app}</h4>
                            <ul>
                                {hrefs.map((href, i) => <li><a href={href} rel="noopener">{sourceLabels[app][i]}</a></li>)}
                            </ul>
                        </div>
                    ))}
                </div>
                <p class="compare-links">
                    <a href={`${prefix}vs/keepassium/`}>KeeForge / KeePassium <span aria-hidden="true">↗</span></a>
                    <a href={`${prefix}vs/strongbox/`}>KeeForge / Strongbox <span aria-hidden="true">↗</span></a>
                </p>
            </div>
        </details>
    </section>
</Page>
