---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  // Paths of the English/German/French/Spanish versions of this page, e.g. '/', '/de/', '/fr/', '/es/'.
  // Whichever are set are emitted as hreflang alternate links for SEO.
  enPath?: string;
  dePath?: string;
  frPath?: string;
  esPath?: string;
}

const SITE = 'https://keeforge.com';
const { title = 'KeeForge — Free, Open-Source KeePass for iOS', description = 'KeeForge is a free, open-source KeePass password manager for iPhone and iPad with AutoFill, passkeys, TOTP, Dropbox, OneDrive and WebDAV sync, and no subscription.', lang = 'en', enPath, dePath, frPath, esPath } = Astro.props;

const alternates = [
    ...(enPath ? [{ code: 'en', path: enPath }] : []),
    ...(dePath ? [{ code: 'de', path: dePath }] : []),
    ...(frPath ? [{ code: 'fr', path: frPath }] : []),
    ...(esPath ? [{ code: 'es', path: esPath }] : []),
];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    {alternates.length > 1 && (
        <>
            {alternates.map((a) => (
                <link rel="alternate" hreflang={a.code} href={`${SITE}${a.path}`}>
            ))}
            <link rel="alternate" hreflang="x-default" href={`${SITE}${enPath ?? alternates[0].path}`}>
        </>
    )}
    <link rel="icon" type="image/png" sizes="512x512" href="/app-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <slot />
</body>
</html>

<style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
        --bg: #fafbfc;
        --surface: #ffffff;
        --border: #e2e8f0;
        --text: #111827;
        --text-dim: #6b7280;
        --accent: #3b82f6;
        --accent-dim: #1d4ed8;
        --green: #16a34a;
        --green-dim: #15803d;
        --amber: #d97706;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.2s;
    }

    a:hover {
        color: #2563eb;
    }

    code, .mono {
        font-family: 'JetBrains Mono', monospace;
    }
</style>
