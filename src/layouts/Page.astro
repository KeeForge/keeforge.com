---
import Base from './Base.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { home } from '../i18n/home';
import '../styles/home.css';
import '../styles/page.css';

// Shared layout for the comparison pages. It reuses the homepage's header,
// footer, and design system (src/styles/home.css); page content styles live
// in src/styles/page.css.
interface Props {
    title?: string;
    description?: string;
    eyebrow?: string;
    heading: string;
    // Optional second part of the heading, shown in the accent color.
    headingAccent?: string;
    lead?: string;
    lang?: 'en' | 'de' | 'fr' | 'es' | 'zh-hans' | 'zh-hant' | 'ja' | 'it' | 'ru';
    // Paths of the localized versions of this page, for the language switcher
    // and hreflang alternates. Omit while no translation exists.
    enPath?: string;
    dePath?: string;
    frPath?: string;
    esPath?: string;
    zhHansPath?: string;
    zhHantPath?: string;
    jaPath?: string;
    itPath?: string;
    ruPath?: string;
    canonicalPath?: string;
    ogType?: 'website' | 'article';
}

const { title, description, eyebrow, heading, headingAccent, lead, lang = 'en', enPath, dePath, frPath, esPath, zhHansPath, zhHantPath, jaPath, itPath, ruPath, canonicalPath, ogType } = Astro.props;

const langPaths = { en: enPath, de: dePath, fr: frPath, es: esPath, 'zh-hans': zhHansPath, 'zh-hant': zhHantPath, ja: jaPath, it: itPath, ru: ruPath };
const hasTranslations = Object.values(langPaths).filter(Boolean).length > 1;

const strings = {
    en: {
        home: '/',
        compare: 'Compare',
        privacyHref: '/privacy',
    },
    de: {
        home: '/de/',
        compare: 'Vergleich',
        privacyHref: '/de/privacy',
    },
    fr: {
        home: '/fr/',
        compare: 'Comparaison',
        privacyHref: '/fr/privacy',
    },
    es: {
        home: '/es/',
        compare: 'Comparativa',
        privacyHref: '/es/privacy',
    },
    'zh-hans': {
        home: '/zh-hans/',
        compare: '对比',
        privacyHref: '/zh-hans/privacy',
    },
    'zh-hant': {
        home: '/zh-hant/',
        compare: '比較',
        privacyHref: '/zh-hant/privacy',
    },
    ja: {
        home: '/ja/',
        compare: '比較',
        privacyHref: '/ja/privacy',
    },
    it: {
        home: '/it/',
        compare: 'Confronto',
        privacyHref: '/it/privacy',
    },
    ru: {
        home: '/ru/',
        compare: 'Сравнение',
        privacyHref: '/ru/privacy',
    },
}[lang];

const t = home[lang];
const source = 'https://github.com/KeeForge/KeeForge';
const changelog = `${source}/blob/main/CHANGELOG.md`;
---

<Base title={title} description={description} lang={lang} canonicalPath={canonicalPath} ogType={ogType} enPath={enPath} dePath={dePath} frPath={frPath} esPath={esPath} zhHansPath={zhHansPath} zhHantPath={zhHantPath} jaPath={jaPath} itPath={itPath} ruPath={ruPath}>
    <div class="kf-home kf-page">
        <a href="#main" class="skip">{t.nav.skip}</a>
        <header class="nav">
            <div class="wrap nav-inner">
                <a class="brand" href={strings.home}><span class="key" aria-hidden="true"></span>KeeForge</a>
                <nav class="navlinks" aria-label={t.nav.menu}>
                    <a href={`${strings.home}#features`}>{t.nav.features}</a>
                    <a href={`${strings.home}#compare`}>{strings.compare}</a>
                    <a href={`${strings.home}#faq`}>{t.nav.faq}</a>
                    <a href={changelog}>{t.nav.changelog}</a>
                    <a href="/security-audit/">{t.nav.audit}</a>
                </nav>
                <div class="navright">
                    {hasTranslations && <div class="header-language"><LanguageSwitcher current={lang} paths={langPaths} variant="header" /></div>}
                    <a class="nav-source" href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                    <a class="btn small" href={`${strings.home}#download`}>{t.nav.download}</a>
                    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">{t.nav.menu}</button>
                </div>
            </div>
            <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.menu} hidden>
                <a href={`${strings.home}#features`}>{t.nav.features}</a>
                <a href={`${strings.home}#compare`}>{strings.compare}</a>
                <a href={`${strings.home}#faq`}>{t.nav.faq}</a>
                <a href={changelog}>{t.nav.changelog}</a>
                <a href="/security-audit/">{t.nav.audit}</a>
                <a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                {hasTranslations && <div class="mobile-languages"><LanguageSwitcher current={lang} paths={langPaths} variant="footer" /></div>}
            </nav>
        </header>

        <main id="main">
            <section class="page-hero wrap">
                {eyebrow && <div class="eyebrow">{eyebrow}</div>}
                <h1>{heading}{headingAccent && <> <span class="accent">{headingAccent}</span></>}</h1>
                {lead && <p class="page-lead">{lead}</p>}
                <slot name="hero" />
            </section>
            <div class="page-body wrap">
                <slot />
            </div>
        </main>

        <footer class="foot">
            <div class="wrap">
                <div class="footer-top">
                    <a href={strings.home} class="brand"><span class="key" aria-hidden="true"></span>KeeForge</a>
                    <nav>
                        {lang === 'en' && <a href="/best-keepass-app-iphone/">Best KeePass apps for iPhone</a>}
                        <a href={strings.privacyHref}>{t.footer.privacy}</a>
                        <a href="mailto:support@keeforge.com">{t.footer.support}</a>
                        <a href="https://apps.apple.com/app/id6759309295">App Store</a>
                        <a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                    </nav>
                </div>
                <div class="footer-bottom"><span>{t.footer.copy}</span>{hasTranslations && <LanguageSwitcher current={lang} paths={langPaths} variant="footer" />}</div>
            </div>
        </footer>
    </div>
</Base>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('mobile-nav');
    if (toggle && menu) {
        const closeMenu = () => { toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; };
        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!expanded));
            menu.hidden = expanded;
        });
        menu.addEventListener('click', event => {
            if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !menu.hidden) { closeMenu(); toggle.focus(); }
        });
        matchMedia('(min-width: 1101px)').addEventListener('change', closeMenu);
    }
</script>
