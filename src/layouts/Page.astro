---
import Base from './Base.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props {
    title?: string;
    description?: string;
    eyebrow?: string;
    heading: string;
    lead?: string;
    lang?: 'en' | 'de' | 'fr' | 'es' | 'zh-hans' | 'zh-hant';
    // Paths of the localized versions of this page, for the language switcher
    // and hreflang alternates. Omit while no translation exists.
    enPath?: string;
    dePath?: string;
    frPath?: string;
    esPath?: string;
    zhHansPath?: string;
    zhHantPath?: string;
}

const { title, description, eyebrow, heading, lead, lang = 'en', enPath, dePath, frPath, esPath, zhHansPath, zhHantPath } = Astro.props;

const langPaths = { en: enPath, de: dePath, fr: frPath, es: esPath, 'zh-hans': zhHansPath, 'zh-hant': zhHantPath };

const strings = {
    en: {
        home: '/',
        compare: 'Compare',
        changelog: 'Changelog',
        audit: 'Security audit',
        faq: 'FAQ',
        homeLabel: 'Home',
        tagline: 'Free, open-source KeePass for iOS',
        privacy: 'Privacy Policy',
        privacyHref: '/privacy',
    },
    de: {
        home: '/de/',
        compare: 'Vergleich',
        changelog: 'Changelog',
        audit: 'Sicherheitsaudit',
        faq: 'FAQ',
        homeLabel: 'Startseite',
        tagline: 'Kostenloser Open-Source-KeePass für iOS',
        privacy: 'Datenschutz',
        privacyHref: '/de/privacy',
    },
    fr: {
        home: '/fr/',
        compare: 'Comparaison',
        changelog: 'Journal des modifications',
        audit: 'Audit de sécurité',
        faq: 'FAQ',
        homeLabel: 'Accueil',
        tagline: 'KeePass gratuit et open source pour iOS',
        privacy: 'Politique de confidentialité',
        privacyHref: '/fr/privacy',
    },
    es: {
        home: '/es/',
        compare: 'Comparativa',
        changelog: 'Historial de cambios',
        audit: 'Auditoría de seguridad',
        faq: 'Preguntas frecuentes',
        homeLabel: 'Inicio',
        tagline: 'KeePass gratuito y de código abierto para iOS',
        privacy: 'Política de privacidad',
        privacyHref: '/es/privacy',
    },
    'zh-hans': {
        home: '/zh-hans/',
        compare: '对比',
        changelog: '更新日志',
        audit: '安全审计',
        faq: '常见问题',
        homeLabel: '首页',
        tagline: '免费开源的 iOS KeePass',
        privacy: '隐私政策',
        privacyHref: '/zh-hans/privacy',
    },
    'zh-hant': {
        home: '/zh-hant/',
        compare: '比較',
        changelog: '更新記錄',
        audit: '安全性稽核',
        faq: '常見問題',
        homeLabel: '首頁',
        tagline: '免費開源的 iOS 版 KeePass',
        privacy: '隱私權政策',
        privacyHref: '/zh-hant/privacy',
    },
}[lang];
---

<Base title={title} description={description} lang={lang} enPath={enPath} dePath={dePath} frPath={frPath} esPath={esPath} zhHansPath={zhHansPath} zhHantPath={zhHantPath}>
    <header class="page-header">
        <div class="page-header-inner">
            <a href={strings.home} class="brand-link">
                <span class="brand-name mono">KeeForge</span>
            </a>
            <nav class="page-nav">
                <a href={`${strings.home}#compare`}>{strings.compare}</a>
                <a href="https://github.com/KeeForge/KeeForge/blob/main/CHANGELOG.md" rel="noopener">{strings.changelog}</a>
                <a href="/security-audit/">{strings.audit}</a>
                <a href={`${strings.home}#faq`}>{strings.faq}</a>
                <a href="https://github.com/KeeForge/KeeForge" rel="noopener">GitHub</a>
                <LanguageSwitcher current={lang} paths={langPaths} variant="header" />
            </nav>
        </div>
    </header>

    <section class="page-hero">
        <div class="page-container">
            {eyebrow && <p class="eyebrow mono">{eyebrow}</p>}
            <h1>{heading}</h1>
            {lead && <p class="page-lead">{lead}</p>}
        </div>
    </section>

    <main class="page-main">
        <div class="page-container">
            <slot />
        </div>
    </main>

    <footer class="footer">
        <div class="page-container">
            <div class="footer-content">
                <div class="footer-brand">
                    <span class="footer-name mono">KeeForge</span>
                    <span class="footer-copy">{strings.tagline}</span>
                </div>
                <div class="footer-links">
                    <a href={strings.home}>{strings.homeLabel}</a>
                    <a href="https://apps.apple.com/us/app/keeforge/id6759309295">App Store</a>
                    <a href="https://github.com/KeeForge/KeeForge">GitHub</a>
                    <a href="https://github.com/KeeForge/KeeForge/blob/main/CHANGELOG.md" rel="noopener">{strings.changelog}</a>
                    <a href="/security-audit/">{strings.audit}</a>
                    <a href={strings.privacyHref}>{strings.privacy}</a>
                    <LanguageSwitcher current={lang} paths={langPaths} variant="footer" />
                </div>
            </div>
        </div>
    </footer>
</Base>

<style>
    .page-header {
        border-bottom: 1px solid var(--border);
        background: var(--bg);
    }

    .page-header-inner {
        max-width: 960px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .brand-link {
        color: var(--text);
    }

    .brand-name {
        font-size: 0.95rem;
        font-weight: 700;
    }

    .page-nav {
        display: flex;
        gap: 20px;
    }

    .page-nav a {
        font-size: 0.85rem;
        color: var(--text-dim);
        transition: color 0.2s;
    }

    .page-nav a:hover {
        color: var(--text);
    }

    .page-hero {
        padding: 56px 0 32px;
        background: linear-gradient(180deg, #eef2ff 0%, var(--bg) 100%);
    }

    .page-container {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .eyebrow {
        font-size: 0.75rem;
        color: var(--accent-dim);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 10px;
    }

    .page-hero h1 {
        font-size: 2.6rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        margin-bottom: 14px;
        color: var(--text);
    }

    .page-lead {
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--text-dim);
        max-width: 640px;
    }

    .page-main {
        padding: 40px 0 64px;
    }

    /* Footer (shared) */
    .footer {
        border-top: 1px solid var(--border);
        padding: 32px 0;
    }

    .footer-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .footer-name {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--text);
    }

    .footer-copy {
        font-size: 0.75rem;
        color: var(--text-dim);
    }

    .footer-links {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .footer-links a {
        font-size: 0.85rem;
        color: var(--text-dim);
        transition: color 0.2s;
    }

    .footer-links a:hover {
        color: var(--text);
    }

    @media (max-width: 640px) {
        .page-hero h1 {
            font-size: 2rem;
        }

        .page-nav {
            gap: 14px;
        }

        .footer-content {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
