---
import Base from './Base.astro';

const { frontmatter } = Astro.props;
const {
    title,
    description,
    heading,
    date,
    dateDisplay,
    model,
} = frontmatter;

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: heading,
    description,
    datePublished: date,
    dateModified: date,
    author: {
        '@type': 'Organization',
        name: 'KeeForge',
        url: 'https://keeforge.com/',
    },
    about: 'KeeForge security audit',
    url: 'https://keeforge.com/security-audit/',
};
---

<Base
    title={title}
    description={description}
    lang="en"
    canonicalPath="/security-audit/"
    ogType="article"
    publishedTime={date}
>
    <div class="audit-root">
        <header class="audit-nav">
            <div class="audit-nav-inner">
                <a href="/" class="audit-brand" aria-label="KeeForge home">
                    <span class="audit-keymark" aria-hidden="true"></span>
                    <span class="audit-brand-name">KeeForge</span>
                </a>
                <nav class="audit-nav-links" aria-label="Primary navigation">
                    <a class="nav-optional" href="/#features">Features</a>
                    <a class="nav-optional" href="/#faq">FAQ</a>
                    <a href="https://github.com/KeeForge/KeeForge/blob/main/CHANGELOG.md" rel="noopener">Changelog</a>
                    <a href="/security-audit/" aria-current="page">Security audit</a>
                    <a class="nav-optional" href="https://github.com/KeeForge/KeeForge" rel="noopener">GitHub</a>
                </nav>
            </div>
        </header>

        <main>
            <header class="audit-hero">
                <div class="audit-shell">
                    <p class="audit-kicker">Point-in-time review record</p>
                    <h1>{heading}</h1>
                    <p class="audit-lead">{description}</p>
                    <dl class="audit-byline" aria-label="Audit details">
                        <div>
                            <dt>Date</dt>
                            <dd><time datetime={date}>{dateDisplay}</time></dd>
                        </div>
                        <div>
                            <dt>Driving model</dt>
                            <dd>{model}</dd>
                        </div>
                        <div>
                            <dt>Status</dt>
                            <dd>Remediated</dd>
                        </div>
                    </dl>
                </div>
            </header>

            <div class="audit-shell audit-content-grid">
                <aside class="audit-margin" aria-label="Document note">
                    <span>Public archive</span>
                    <p>Point-in-time review of the audited and remediated source revisions.</p>
                </aside>
                <article class="audit-prose">
                    <slot />
                </article>
            </div>
        </main>

        <footer class="audit-footer">
            <div class="audit-shell audit-footer-inner">
                <div>
                    <span class="audit-footer-name">KeeForge</span>
                    <p>Free, open-source KeePass for iOS.</p>
                </div>
                <nav aria-label="Footer navigation">
                    <a href="/">Home</a>
                    <a href="https://github.com/KeeForge/KeeForge">Source</a>
                    <a href="/privacy">Privacy</a>
                </nav>
            </div>
        </footer>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</Base>

<style is:global>
    /* Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4
     * genre: editorial · macrostructure: Long Document · theme: KeeForge Newsprint
     * audience: KeeForge users and evaluators · use: read and verify the audit · tone: technical and austere
     * enrichment: none · nav: existing KeeForge bar · footer: dense colophon
     * contrast: pass · honest copy: pass · responsive: pass at 320 / 375 / 414 / 768
     */
    .audit-root {
        --audit-paper: oklch(94% 0.028 83);
        --audit-paper-deep: oklch(90% 0.039 82);
        --audit-surface: oklch(97% 0.019 86);
        --audit-ink: oklch(25% 0.022 62);
        --audit-ink-soft: oklch(43% 0.034 62);
        --audit-ink-mute: oklch(57% 0.032 66);
        --audit-rule: oklch(83% 0.041 82);
        --audit-accent: oklch(57% 0.14 40);
        --audit-accent-deep: oklch(46% 0.12 40);
        --audit-navy: oklch(40% 0.083 273);
        --audit-gold: oklch(72% 0.135 78);
        --audit-focus: oklch(53% 0.16 264);
        --audit-serif: 'Newsreader', Georgia, serif;
        --audit-sans: 'Instrument Sans', system-ui, sans-serif;
        --audit-mono: 'JetBrains Mono', ui-monospace, monospace;
        --space-xs: 0.25rem;
        --space-sm: 0.5rem;
        --space-md: 1rem;
        --space-lg: 1.5rem;
        --space-xl: 2rem;
        --space-2xl: 3rem;
        --space-3xl: 4rem;
        --rule-thin: 1px;
        --radius-sm: 0.375rem;
        --text-sm: 0.8125rem;
        --text-body: 1.0625rem;
        --text-h3: 1.35rem;
        --text-h2: clamp(1.75rem, 3vw, 2.3rem);
        --text-display: clamp(3.25rem, 8vw, 6.5rem);
        background: var(--audit-paper);
        color: var(--audit-ink);
        font-family: var(--audit-sans);
        min-height: 100vh;
    }

    html,
    body {
        overflow-x: clip;
    }

    .audit-root a {
        color: inherit;
    }

    .audit-root a:focus-visible {
        outline: 3px solid var(--audit-focus);
        outline-offset: 4px;
    }

    .audit-shell {
        width: min(100% - 2rem, 72rem);
        margin-inline: auto;
    }

    .audit-nav {
        border-bottom: var(--rule-thin) solid var(--audit-rule);
        background: var(--audit-paper);
    }

    .audit-nav-inner {
        width: min(100% - 2rem, 72rem);
        min-height: 4.75rem;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-lg);
    }

    .audit-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .audit-keymark {
        width: 2.125rem;
        height: 2.125rem;
        border-radius: 0.5rem;
        background: var(--audit-navy);
        position: relative;
        flex: none;
    }

    .audit-keymark::after {
        content: '';
        position: absolute;
        inset: 11%;
        background: var(--audit-gold);
        -webkit-mask: url('/keeforge-key.svg') center / contain no-repeat;
        mask: url('/keeforge-key.svg') center / contain no-repeat;
    }

    .audit-brand-name,
    .audit-footer-name {
        font-family: var(--audit-serif);
        font-size: 1.375rem;
        font-weight: 500;
    }

    .audit-nav-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(0.875rem, 2.5vw, 1.75rem);
    }

    .audit-nav-links a {
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
        color: var(--audit-ink-soft);
        font-size: 0.90625rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .audit-nav-links a:hover,
    .audit-nav-links a[aria-current='page'] {
        color: var(--audit-accent-deep);
    }

    .audit-nav-links a:active,
    .audit-footer nav a:active,
    .audit-prose a:active {
        color: var(--audit-accent);
    }

    .audit-nav-links a[aria-current='page'] {
        text-decoration: underline;
        text-decoration-thickness: 0.1em;
        text-underline-offset: 0.35em;
    }

    .audit-hero {
        padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 7vw, 5rem);
        border-bottom: var(--rule-thin) solid var(--audit-rule);
    }

    .audit-kicker {
        margin-bottom: var(--space-lg);
        color: var(--audit-accent-deep);
        font-family: var(--audit-mono);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .audit-hero h1 {
        min-width: 0;
        max-width: 10ch;
        margin: 0;
        color: var(--audit-ink);
        font-family: var(--audit-serif);
        font-size: var(--text-display);
        font-style: normal;
        font-weight: 500;
        letter-spacing: -0.045em;
        line-height: 0.92;
        overflow-wrap: anywhere;
    }

    .audit-lead {
        max-width: 48rem;
        margin-top: var(--space-xl);
        color: var(--audit-ink-soft);
        font-family: var(--audit-serif);
        font-size: clamp(1.25rem, 2.3vw, 1.65rem);
        line-height: 1.45;
    }

    .audit-byline {
        margin-top: var(--space-2xl);
        padding-top: var(--space-lg);
        border-top: var(--rule-thin) solid var(--audit-rule);
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-xl);
    }

    .audit-byline dt {
        color: var(--audit-ink-mute);
        font-family: var(--audit-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .audit-byline dd {
        margin-top: var(--space-sm);
        color: var(--audit-ink);
        font-size: 1rem;
        font-weight: 600;
    }

    .audit-content-grid {
        padding-block: clamp(3rem, 7vw, 6rem);
        display: grid;
        grid-template-columns: minmax(8rem, 0.8fr) minmax(0, 3fr);
        gap: clamp(2rem, 7vw, 7rem);
        align-items: start;
    }

    .audit-margin {
        position: sticky;
        top: var(--space-xl);
        color: var(--audit-ink-mute);
        font-size: var(--text-sm);
        line-height: 1.5;
    }

    .audit-margin span {
        display: block;
        margin-bottom: 0.75rem;
        color: var(--audit-accent-deep);
        font-family: var(--audit-mono);
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .audit-prose {
        min-width: 0;
        max-width: 65ch;
        font-family: var(--audit-serif);
        font-size: var(--text-body);
        line-height: 1.72;
    }

    .audit-prose > :first-child {
        margin-top: 0;
    }

    .audit-prose h2,
    .audit-prose h3 {
        min-width: 0;
        color: var(--audit-ink);
        font-family: var(--audit-serif);
        font-style: normal;
        font-weight: 500;
        line-height: 1.12;
        overflow-wrap: anywhere;
    }

    .audit-prose h2 {
        margin: 3.75rem 0 1.25rem;
        padding-top: 1.5rem;
        border-top: var(--rule-thin) solid var(--audit-rule);
        font-size: var(--text-h2);
        letter-spacing: -0.025em;
    }

    .audit-prose h3 {
        margin: 2.75rem 0 1rem;
        font-size: var(--text-h3);
    }

    .audit-prose p,
    .audit-prose ul,
    .audit-prose ol,
    .audit-prose table,
    .audit-prose blockquote {
        margin-block: 1.15rem;
    }

    .audit-prose ul,
    .audit-prose ol {
        padding-left: 1.35rem;
    }

    .audit-prose li + li {
        margin-top: 0.45rem;
    }

    .audit-prose strong {
        font-weight: 600;
    }

    .audit-prose a {
        color: var(--audit-accent-deep);
        text-decoration: underline;
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
    }

    .audit-prose code {
        padding: 0.12em 0.32em;
        border: var(--rule-thin) solid var(--audit-rule);
        border-radius: var(--radius-sm);
        background: var(--audit-surface);
        font-family: var(--audit-mono);
        font-size: 0.82em;
        overflow-wrap: anywhere;
    }

    .audit-prose pre {
        max-width: 100%;
        overflow-x: auto;
        padding: var(--space-lg);
        border: var(--rule-thin) solid var(--audit-rule);
        background: var(--audit-surface);
    }

    .audit-prose pre code {
        padding: 0;
        border: 0;
        background: transparent;
        overflow-wrap: normal;
    }

    .audit-prose table {
        display: block;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        font-family: var(--audit-sans);
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .audit-prose th,
    .audit-prose td {
        min-width: 8rem;
        padding: 0.75rem 1rem 0.75rem 0;
        border-bottom: var(--rule-thin) solid var(--audit-rule);
        text-align: left;
        vertical-align: top;
    }

    .audit-prose th {
        color: var(--audit-ink-soft);
        font-weight: 600;
    }

    .audit-prose blockquote {
        padding-left: var(--space-lg);
        border-left: 0.2rem solid var(--audit-accent);
        color: var(--audit-ink-soft);
    }

    .audit-prose hr {
        margin-block: var(--space-2xl);
        border: 0;
        border-top: var(--rule-thin) solid var(--audit-rule);
    }

    .audit-footer {
        padding-block: var(--space-2xl);
        border-top: var(--rule-thin) solid var(--audit-rule);
        background: var(--audit-paper-deep);
    }

    .audit-footer-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-xl);
    }

    .audit-footer p {
        margin-top: var(--space-sm);
        color: var(--audit-ink-soft);
        font-size: var(--text-sm);
    }

    .audit-footer nav {
        display: flex;
        gap: var(--space-lg);
    }

    .audit-footer nav a {
        min-height: 2.75rem;
        display: inline-flex;
        align-items: center;
        color: var(--audit-ink-soft);
        font-size: var(--text-sm);
        text-decoration: none;
        white-space: nowrap;
    }

    .audit-footer nav a:hover {
        color: var(--audit-accent-deep);
    }

    @media (max-width: 48rem) {
        .audit-nav-inner {
            padding-block: 0.625rem;
            flex-wrap: wrap;
        }

        .audit-nav-links {
            width: 100%;
            justify-content: flex-start;
        }

        .audit-nav-links .nav-optional {
            display: none;
        }

        .audit-content-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-xl);
        }

        .audit-margin {
            position: static;
            padding-bottom: var(--space-lg);
            border-bottom: var(--rule-thin) solid var(--audit-rule);
        }
    }

    @media (max-width: 30rem) {
        .audit-shell,
        .audit-nav-inner {
            width: min(100% - 1.5rem, 72rem);
        }

        .audit-hero h1 {
            font-size: clamp(3rem, 17vw, 4.5rem);
        }

        .audit-byline {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-lg);
        }

        .audit-footer-inner {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>
