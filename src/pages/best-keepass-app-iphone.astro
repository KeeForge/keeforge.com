---
import Page from '../layouts/Page.astro';

const title = 'Best KeePass App for iPhone (2026): 5 Apps Compared';
const description = 'KeeForge, KeePassium, Strongbox, PanicVault and OneKeePass compared on price, what is paywalled, open source, AutoFill, passkeys, sync, key files, YubiKey and security audits. Every fact is linked and was checked on 24 November 2026.';
const checked = '24 November 2026';

// Each cell is plain text; links to the sources live in the Sources section.
const apps = ['KeeForge', 'KeePassium', 'Strongbox', 'PanicVault', 'OneKeePass'];
const rows: { label: string; cells: string[] }[] = [
