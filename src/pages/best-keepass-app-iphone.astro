---
import Base from '../layouts/Base.astro';
import DownloadLinks from '../components/DownloadLinks.astro';
import { home } from '../i18n/home';
import '../styles/home.css';

const t = home.en;
const path = '/best-keepass-app-iphone/';
const source = 'https://github.com/KeeForge/KeeForge';

const title = 'Best KeePass App for iPhone (2026): 5 Apps Compared';
const description = 'KeeForge, KeePassium, Strongbox, PanicVault and OneKeePass compared on price, what is paywalled, open source, AutoFill, passkeys, sync, key files, YubiKey and security audits. Every fact is linked and was checked on 24 November 2026.';
const checked = '24 November 2026';

// Each cell is plain text; links to the sources live in the Sources section.
const apps = ['KeeForge', 'KeePassium', 'Strongbox', 'PanicVault', 'OneKeePass'];
const rows: { label: string; cells: string[] }[] = [
    {
        label: 'Price on iPhone',
        cells: [
            'Free. Optional tip jar.',
            'Free for one database. Premium €19.99/year (rent-to-own) or Pro €79.99 once.',
            'Free for non-commercial use. Pro $2.99/month, $24.99/year or $124.99 lifetime (website prices).',
            '$4.99 once (US App Store). No free version.',
            'Free.',
        ],
    },
    {
        label: 'Paid features',
        cells: [
            'None.',
            'More than one database, YubiKey, Quick AutoFill, password audit, linked databases, business cloud accounts.',
            'On iPhone: Face ID / Touch ID unlock, offline editing, YubiKey, Apple Watch. On Mac, AutoFill, passkeys, SFTP and WebDAV are also Pro.',
            'None after purchase.',
            'None.',
        ],
    },
    {
        label: 'Source code',
        cells: [
            'Open source, GPLv3, whole app.',
            'Open source, GPLv3.',
            'Published under AGPL-3.0, but the project calls itself "source available": no build path, and code drops lag releases.',
            'Closed source.',
            'Open source, GPLv3.',
        ],
    },
    {
        label: 'Apple platforms',
        cells: [
            'iPhone, iPad, Mac (native Mac app).',
            'iPhone, iPad, Mac (Mac Catalyst), Vision Pro.',
            'iPhone, iPad, Mac, Apple Watch, Vision Pro.',
            'iPhone, iPad, Mac, Vision Pro.',
            'iPhone, iPad. Desktop apps for Mac, Windows and Linux, plus Android.',
        ],
    },
    {
        label: 'Minimum iOS',
        cells: ['iOS 18', 'iOS 17', 'iOS 15', 'iOS 17.6', 'iOS 15.1'],
    },
    {
        label: 'Database formats',
        cells: [
            'KDBX 4 read and write. KDBX 3.1 read-only.',
            'KDBX 4, KDBX 3 and KeePass 1 (.kdb).',
            'KDBX 4.1, 4.0 and 3.1, KeePass 1 (.kdb), and Password Safe 3.',
            'KDBX 4 only. Older files must be upgraded first.',
            'KDBX 4.',
        ],
    },
    {
        label: 'Password AutoFill',
        cells: ['Yes', 'Yes', 'Yes', 'Yes', 'Yes'],
    },
    {
        label: 'Passkeys',
        cells: [
            'Yes, in AutoFill. KeePassXC-compatible.',
            'Yes, in AutoFill. KeePassXC-compatible.',
            'Yes (free on iPhone, Pro on Mac).',
            'Stores KeePassXC-format passkeys. iPhone passkey AutoFill not documented.',
            'Yes, on iOS 17 and later.',
        ],
    },
    {
        label: '2FA (TOTP) codes',
        cells: [
            'Yes, including AutoFill on iOS 18 and Mac.',
            'Yes, including AutoFill on iOS 18.',
            'Yes.',
            'Yes, in the app. The Mac browser extension fills them.',
            'Yes, including AutoFill.',
        ],
    },
    {
        label: 'Built-in sync',
        cells: [
            'iPhone and iPad: Dropbox, OneDrive, WebDAV, FTP, plus iCloud Drive and other Files providers. Mac: WebDAV, FTP and synced folders.',
            'Dropbox, Google Drive, OneDrive, WebDAV, plus iCloud Drive and other Files providers.',
            'iCloud, Dropbox, OneDrive, Google Drive, WebDAV, SFTP, plus Files providers. SharePoint is Pro.',
            'iCloud Drive and Google Drive.',
            'SFTP, WebDAV, plus Files providers.',
        ],
    },
    {
        label: 'Key files',
        cells: ['Yes, and can create them', 'Yes, and can create them', 'Yes', 'Yes', 'Yes, and can create them'],
    },
    {
        label: 'YubiKey',
        cells: [
            'Read-only, on iPhone over NFC.',
            'Paid. Lightning, NFC on iPhone, USB on Mac.',
            'Pro. USB-C keys not supported on iOS.',
            'NFC on iPhone, USB on Mac. Not on iPad.',
            'Not documented.',
        ],
    },
    {
        label: 'Independent security audit',
        cells: [
            'None.',
            'Yes: Cure53, October 2024.',
            'No code-level audit, per Strongbox. Yearly CASA Tier 2 assessment.',
            'None published.',
            'None published.',
        ],
    },
    {
        label: 'App languages',
        cells: ['9', '20', '18', '1 (English)', '1 (English)'],
    },
    {
        label: 'Latest App Store update (US)',
        cells: ['1.23.0, 22 Nov 2026', '2.5, 19 Nov 2025', '1.65.2, 1 Sep 2026', '1.1.7, 14 Nov 2026', '0.25.0, 18 Nov 2026'],
    },
];

const sources: { group: string; links: { label: string; href: string }[] }[] = [
    {
        group: 'KeeForge',
        links: [
            { label: 'README (features, sync, formats)', href: 'https://github.com/KeeForge/KeeForge/blob/main/README.md' },
            { label: 'Changelog (1.23.0 release, YubiKey support)', href: 'https://github.com/KeeForge/KeeForge/blob/main/CHANGELOG.md' },
            { label: 'GPLv3 license', href: 'https://github.com/KeeForge/KeeForge/blob/main/LICENSE' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6759309295' },
        ],
    },
    {
        group: 'KeePassium',
        links: [
            { label: 'Pricing and free vs paid comparison', href: 'https://keepassium.com/pricing/' },
            { label: 'Security audits (Cure53, CASA)', href: 'https://support.keepassium.com/kb/security-audits/' },
            { label: 'Cure53 audit report, October 2024 (PDF)', href: 'https://keepassium.com/audit/2024-10-Cure53.pdf' },
            { label: 'Sync options', href: 'https://support.keepassium.com/kb/sync/' },
            { label: 'YubiKey compatibility', href: 'https://support.keepassium.com/kb/yubikey-compatibility/' },
            { label: 'KeePassium 2.0: passkeys, Mac app, 2FA AutoFill', href: 'https://keepassium.com/blog/2024/12/keepassium-2.0/' },
            { label: 'Source code', href: 'https://github.com/keepassium/KeePassium' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id1435127111' },
        ],
    },
    {
        group: 'Strongbox',
        links: [
            { label: 'Free vs Pro comparison', href: 'https://strongboxsafe.com/comparison/' },
            { label: 'Pro pricing', href: 'https://strongboxsafe.com/pricing/' },
            { label: 'Supported KeePass versions', href: 'https://strongbox.reamaze.com/kb/faqs/what-version-of-keepass-does-strongbox-support' },
            { label: 'Statement on security audits', href: 'https://strongbox.reamaze.com/kb/security-and-privacy/security-audit' },
            { label: 'Strongbox joins Applause (March 2025)', href: 'https://strongboxsafe.com/strongbox-joins-applause/' },
            { label: 'Source code and license notes', href: 'https://github.com/strongbox-password-safe/Strongbox' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id897283731' },
        ],
    },
    {
        group: 'PanicVault',
        links: [
            { label: 'Homepage', href: 'https://panicvault.org/' },
            { label: 'User manual', href: 'https://www.panicvault.org/help/' },
            { label: 'PanicVault’s own KeePass for iPhone guide', href: 'https://www.panicvault.org/keepass/keepass-ios/' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6759188575' },
        ],
    },
    {
        group: 'OneKeePass',
        links: [
            { label: 'Homepage', href: 'https://onekeepass.com/' },
            { label: 'Mobile source code', href: 'https://github.com/onekeepass/mobile' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6448712640' },
        ],
    },
    {
        group: 'KeePassXC',
        links: [
            { label: 'FAQ: “Does KeePassXC work on mobile phones?”', href: 'https://keepassxc.org/docs/' },
        ],
    },
];

const picks = [
    { need: 'You want an independently audited app', app: 'KeePassium.', why: 'The only one here with a published third-party code audit (Cure53, 2024). Free for one database.' },
    { need: 'You want the most features', app: 'Strongbox.', why: 'Password Safe files, Apple Watch, a duress PIN and the widest sync list. Face ID unlock and offline editing need Pro.' },
    { need: 'You want everything free and open source', app: 'KeeForge or OneKeePass.', why: 'KeeForge covers iPhone, iPad and Mac; OneKeePass also runs on Android, Windows and Linux. No paid tier and no database limit in either.' },
    { need: 'You’d rather pay once', app: 'PanicVault.', why: 'A single $4.99 purchase covers iPhone, iPad and Mac. Closed source, KDBX 4 only.' },
];

const notes = [
    { app: 'KeePassium', body: 'The established choice. KeePassium is open source under GPLv3, and it is the only app here that has had an independent audit: Cure53 reviewed the iOS app and its cryptography in October 2024, and the developer says every finding was fixed in the next update. The free version is capable (sync, AutoFill, Face ID, 2FA codes) but limited to one database; YubiKey and Quick AutoFill are paid. Its Mac app is built with Mac Catalyst. Its App Store build was last updated in November 2025, though newer 2.6 versions are tagged in its source repository.' },
    { app: 'Strongbox', body: 'The most feature-rich. Strongbox also opens Password Safe files, runs on Apple Watch and Vision Pro, and connects directly to the longest list of storage services, including SFTP. The free version includes AutoFill, passkeys, 2FA codes and key files on iPhone, but Face ID / Touch ID unlock and offline editing are Pro features, which many people will want. Strongbox was acquired by Applause in March 2025. Its code is published under AGPL-3.0, but the project itself calls it “source available” rather than open source, and the published code trails the App Store releases. Strongbox says it has not had an independent code-level audit.' },
    { app: 'PanicVault', body: 'The simple one-time purchase. PanicVault costs $4.99 once on the US App Store, with no subscription or in-app purchases, and covers iPhone, iPad, Mac and Vision Pro. It supports key files and YubiKey over NFC on iPhone and USB on Mac. It is closed source, opens KDBX 4 databases only, syncs directly with iCloud Drive and Google Drive, and is available in English only. PanicVault publishes its own KeePass-for-iPhone guide, which is worth reading alongside this one.' },
    { app: 'OneKeePass', body: 'The cross-platform open-source option. OneKeePass is free and GPLv3, with apps for iPhone, iPad and Android and desktop apps for Mac, Windows and Linux, so it suits you if your devices aren’t all Apple. On iPhone it AutoFills passwords, 2FA codes and passkeys, and connects directly to SFTP and WebDAV. It is still pre-1.0 (version 0.25), English only, and doesn’t document YubiKey support.' },
    { app: 'KeeForge', body: 'Our app. KeeForge is free, open source under GPLv3, and has no account, subscription, paid tier or database limit. It runs on iPhone, iPad and Mac, where 1.23 rebuilt it as a native Mac app. It reads and writes KDBX 4, opens KDBX 3.1 read-only, and AutoFills passwords, passkeys and 2FA codes. On iPhone and iPad it connects directly to Dropbox, OneDrive, WebDAV and FTP and opens files from iCloud Drive and other Files providers; on Mac it uses WebDAV, FTP and synced folders. Where it falls short: it needs iOS 18, YubiKey databases open read-only and only on iPhone over NFC, it has no Google Drive connection yet, it is newer and smaller than KeePassium or Strongbox, and it has not had an independent security audit.' },
];

---

<Base title={title} description={description} lang="en" canonicalPath={path} ogType="article">
    <div class="kf-home kf-guide">
        <a href="#main" class="skip">{t.nav.skip}</a>
        <header class="nav">
            <div class="wrap nav-inner">
                <a class="brand" href="/"><span class="key" aria-hidden="true"></span>KeeForge</a>
                <nav class="navlinks" aria-label={t.nav.menu}>
                    <a href="/#features">{t.nav.features}</a>
                    <a href="/#compare">Compare</a>
                    <a href="/#faq">{t.nav.faq}</a>
                    <a href={`${source}/blob/main/CHANGELOG.md`}>{t.nav.changelog}</a>
                    <a href="/security-audit/">{t.nav.audit}</a>
                </nav>
                <div class="navright">
                    <a class="nav-source" href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
                    <a class="btn small" href="#download">{t.nav.download}</a>
                    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">{t.nav.menu}</button>
                </div>
            </div>
            <nav id="mobile-nav" class="mobile-nav" aria-label={t.nav.menu} hidden>
                <a href="/#features">{t.nav.features}</a>
                <a href="/#compare">Compare</a>
                <a href="/#faq">{t.nav.faq}</a>
                <a href={`${source}/blob/main/CHANGELOG.md`}>{t.nav.changelog}</a>
                <a href="/security-audit/">{t.nav.audit}</a>
                <a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a>
            </nav>
        </header>

        <main id="main">
            <section class="guide-hero wrap">
                <div class="eyebrow">Buyer’s guide · Checked {checked}</div>
                <h1>The best KeePass app <span class="accent">for iPhone.</span></h1>
                <p class="lead">There is no official KeePass app for iPhone, so you pick a compatible client. We compared five current apps on what you pay for, whether you can read the code, and what works in AutoFill.</p>
                <aside class="disclosure">
                    <div class="eyebrow">Who wrote this</div>
                    <p>We make KeeForge, one of the apps below. To keep this useful anyway, every fact comes from the vendor’s own pages, linked under <a href="#sources">Sources</a>, we say where each app beats ours, and we left out claims we couldn’t check. If something is wrong or out of date, <a href="mailto:support@keeforge.com">tell us</a> and we’ll fix it.</p>
                </aside>
            </section>

            <section class="guide-section wrap" id="short-answer">
                <div class="section-heading">
                    <div class="eyebrow">01 · The short answer</div>
                    <h2>It depends on what you care about most.</h2>
                    <p>All five open the same KeePass <code>.kdbx</code> files, so you can try more than one on the same database.</p>
                </div>
                <div class="compare-grid picks">
                    {picks.map((pick, i) => (
                        <article>
                            <div class="eyebrow">{String(i + 1).padStart(2, '0')} / {String(picks.length).padStart(2, '0')}</div>
                            <h3>{pick.need}</h3>
                            <p><strong>{pick.app}</strong> {pick.why}</p>
                        </article>
                    ))}
                </div>
            </section>

            <section class="guide-band" id="comparison">
                <div class="wrap">
                    <div class="section-heading">
                        <div class="eyebrow">02 · Side by side</div>
                        <h2>Five KeePass apps for iPhone, compared.</h2>
                        <p class="note">Checked {checked} against each vendor’s website, App Store listing and source repository. Prices are US App Store or vendor website prices and can differ by country. On a phone, swipe the table sideways.</p>
                    </div>
                    <div class="table-wrap" tabindex="0" role="region" aria-label="KeePass apps for iPhone compared">
                        <table>
                            <thead>
                                <tr>
                                    <th scope="col"><span class="visually-hidden">Feature</span></th>
                                    {apps.map((app) => <th scope="col">{app}</th>)}
                                </tr>
                            </thead>
                            <tbody>
                                {rows.map((row) => (
                                    <tr>
                                        <th scope="row">{row.label}</th>
                                        {row.cells.map((cell) => <td>{cell}</td>)}
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="guide-section split wrap" id="apps">
                <div>
                    <div class="eyebrow">03 · Each app</div>
                    <h2>Strengths and trade-offs, in a paragraph each.</h2>
                </div>
                <div class="app-notes">
                    {notes.map((note) => (
                        <article>
                            <h3>{note.app}</h3>
                            <p>{note.body}</p>
                        </article>
                    ))}
                </div>
            </section>

            <section class="guide-section split wrap" id="keepassxc">
                <div>
                    <div class="eyebrow">04 · KeePassXC users</div>
                    <h2>Coming from KeePassXC?</h2>
                </div>
                <div class="prose">
                    <p>KeePassXC has no iPhone app. Its FAQ says the team doesn’t make a mobile app and suggests Strongbox and KeePassium on iOS. Any app in this guide opens a KeePassXC database, as long as it is KDBX 4 (KeePassXC’s default). If you store passkeys in KeePassXC, KeeForge, KeePassium and PanicVault all read KeePassXC’s passkey format.</p>
                    <p>To use the same database on your computer and your iPhone, put the file somewhere both can reach, such as iCloud Drive, Dropbox, OneDrive or a WebDAV server, then add it in the iPhone app. Check that the app you choose connects to the service you already use.</p>
                    <div class="compare-links">
                        <a href="/vs/keepassium/">KeeForge / KeePassium <span aria-hidden="true">↗</span></a>
                        <a href="/vs/strongbox/">KeeForge / Strongbox <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
            </section>

            <section class="guide-section wrap" id="sources">
                <div class="section-heading">
                    <div class="eyebrow">05 · Sources</div>
                    <h2>Where every fact comes from.</h2>
                    <p>Opened and checked on {checked}. App versions and dates are from the US App Store.</p>
                </div>
                <div class="sources">
                    {sources.map((group) => (
                        <div>
                            <h3>{group.group}</h3>
                            <ul>
                                {group.links.map((link) => <li><a href={link.href} rel="noopener">{link.label}</a></li>)}
                            </ul>
                        </div>
                    ))}
                </div>
            </section>

            <section class="beta">
                <div class="wrap beta-grid">
                    <div>
                        <div class="eyebrow">Try KeeForge</div>
                        <h2>Free, open source, <span class="accent">no account.</span></h2>
                        <p>Open the KeePass database you already have. There is no paid tier, subscription or database limit.</p>
                        <DownloadLinks labels={t.downloads} id="download" />
                    </div>
                </div>
            </section>
        </main>

        <footer class="foot">
            <div class="wrap">
                <div class="footer-top">
                    <a href="/" class="brand"><span class="key" aria-hidden="true"></span>KeeForge</a>
                    <nav><a href={t.footer.privacyHref}>{t.footer.privacy}</a>
                        <a href="mailto:support@keeforge.com">{t.footer.support}</a><a href={source}>{t.nav.source} <span aria-hidden="true">↗</span></a></nav>
                </div>
                <div class="footer-bottom"><span>{t.footer.copy}</span></div>
            </div>
        </footer>
    </div>
</Base>

<script>
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
    const menu = document.getElementById('mobile-nav');
    if (toggle && menu) {
        const closeMenu = () => { toggle.setAttribute('aria-expanded', 'false'); menu.hidden = true; };
        toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!expanded));
            menu.hidden = expanded;
        });
        menu.addEventListener('click', event => {
            if (event.target instanceof Element && event.target.closest('a')) closeMenu();
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !menu.hidden) { closeMenu(); toggle.focus(); }
        });
        matchMedia('(min-width: 1101px)').addEventListener('change', closeMenu);
    }
</script>

<style>
    /* Builds on the homepage design system in src/styles/home.css. */
    .kf-guide .guide-hero { padding-block: 72px 56px; max-width: 1280px; }
    .kf-guide .guide-hero h1 { font-size: clamp(44px, 5.1vw, 74px); line-height: 1.04; max-width: 14ch; }
    .kf-guide .guide-hero .lead { font-size: 18px; max-width: 58ch; margin-top: 24px; }
    .kf-guide .disclosure { margin-top: 40px; max-width: 760px; padding: 24px 28px; background: var(--paper); border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 12px; }
    .kf-guide .disclosure .eyebrow { margin-bottom: 10px; }
    .kf-guide .disclosure p { font-size: 15px; }
    .kf-guide a:not(.btn, .brand, .direct) { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--rule); }
    .kf-guide a:not(.btn, .brand, .direct):hover { text-decoration-color: currentColor; }
    .kf-guide .nav a, .kf-guide .foot a, .kf-guide .skip { text-decoration: none !important; }
    .kf-guide .nav a:hover, .kf-guide .foot a:hover { text-decoration: underline !important; }
    .kf-guide main p a { color: var(--accent); }

    .kf-guide .guide-section { padding-block: 72px; border-top: 1px solid var(--rule); }
    .kf-guide .section-heading p { margin-top: 16px; max-width: 62ch; }
    .kf-guide .section-heading .note { font-size: 13px; }
    .kf-guide .picks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kf-guide .picks h3 { min-height: 0; }
    .kf-guide .picks p { margin-top: 14px; font-size: 15px; }
    .kf-guide .picks strong { color: var(--ink); font-weight: 600; }

    .kf-guide .guide-band { background: var(--alt); border-block: 1px solid var(--rule); padding-block: 72px; }
    .kf-guide .table-wrap { overflow-x: auto; background: var(--paper); border: 1px solid var(--rule); border-radius: 16px; }
    .kf-guide .table-wrap:focus-visible { outline: 3px solid var(--navy); outline-offset: 4px; }
    .kf-guide table { width: 100%; min-width: 900px; border-collapse: separate; border-spacing: 0; font-size: 14px; }
    .kf-guide th, .kf-guide td { padding: 16px 18px; text-align: left; vertical-align: top; line-height: 1.55; border-top: 1px solid var(--rule); }
    .kf-guide thead th { border-top: 0; font: 500 22px var(--serif); letter-spacing: -.02em; color: var(--ink); white-space: nowrap; padding-block: 20px; }
    .kf-guide thead th:nth-child(2) { color: var(--accent); }
    .kf-guide tbody th { font: 400 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--soft); width: 160px; padding-top: 19px; }
    .kf-guide td { color: var(--soft); }
    /* Keep the row labels in view while the table scrolls sideways. */
    .kf-guide th:first-child { position: sticky; left: 0; z-index: 1; background: var(--paper); border-right: 1px solid var(--rule); }
    .kf-guide .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    .kf-guide .split { display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: 80px; }
    .kf-guide .split h2 { font-size: 44px; }
    .kf-guide .app-notes article { padding-block: 28px; border-bottom: 1px solid var(--rule); }
    .kf-guide .app-notes article:first-child { padding-top: 0; }
    .kf-guide .app-notes h3 { font-size: 28px; }
    .kf-guide .app-notes p, .kf-guide .prose p { margin-top: 12px; font-size: 16px; }
    .kf-guide .prose p:first-child { margin-top: 0; }

    .kf-guide .sources { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 48px; }
    .kf-guide .sources h3 { font: 400 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--accent); padding-bottom: 12px; border-bottom: 1px solid var(--rule); }
    .kf-guide .sources ul { list-style: none; padding: 0; margin-top: 14px; display: flex; flex-direction: column; gap: 10px; }
    .kf-guide .sources li { font-size: 14px; line-height: 1.5; color: var(--ink); overflow-wrap: anywhere; }

    .kf-guide .beta-grid { grid-template-columns: minmax(0, 1fr); }

