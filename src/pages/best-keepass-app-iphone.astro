            { label: 'Statement on security audits', href: 'https://strongbox.reamaze.com/kb/security-and-privacy/security-audit' },
            { label: 'Strongbox joins Applause (March 2025)', href: 'https://strongboxsafe.com/strongbox-joins-applause/' },
