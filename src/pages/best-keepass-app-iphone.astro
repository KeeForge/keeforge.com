---
import Page from '../layouts/Page.astro';
import DownloadLinks from '../components/DownloadLinks.astro';
import { home } from '../i18n/home';

const path = '/best-keepass-app-iphone/';

const title = 'Best KeePass App for iPhone (2026): KeeForge vs KeePassium, Strongbox and PanicVault';
const description = 'KeeForge is the KeePass app for iPhone with every feature free: open source, no subscription, Face ID, passkeys and 2FA AutoFill included. See how it compares with KeePassium, Strongbox and PanicVault. Checked 24 November 2026.';
const checked = '24 November 2026';

// The at-a-glance list. Every claim here must also be backed by the full
// table and the vendor pages listed under Sources.
const rivals = ['KeePassium', 'Strongbox', 'PanicVault'];
// Lets narrow screens wrap app names between their words, never mid-word.
const wrapName = (name: string) => name.replace(/([a-z])([A-Z])/g, '$1<wbr>$2').replace('Strongbox', 'Strong<wbr>box');
const verdict: { label: string; keeforge: string; rivals: { ok: boolean; note: string }[] }[] = [
    {
        label: 'Every feature free',
        keeforge: 'No paid tier, no subscription',
        rivals: [
            { ok: false, note: '1 database free' },
            { ok: false, note: 'Paid Pro upgrade' },
            { ok: false, note: '$4.99 upfront' },
        ],
    },
    {
        label: 'Face ID unlock at no cost',
        keeforge: 'Free, with no account',
        rivals: [
            { ok: true, note: 'Free' },
            { ok: false, note: 'Pro only' },
            { ok: false, note: 'Needs the $4.99 app' },
        ],
    },
    {
        label: 'Fully open source',
        keeforge: 'GPLv3, the whole app',
        rivals: [
            { ok: true, note: 'GPLv3' },
            { ok: false, note: '“Source available”' },
            { ok: false, note: 'Closed source' },
        ],
    },
    {
        label: 'Dropbox & OneDrive built in',
        keeforge: 'Plus WebDAV, FTP and iCloud Drive',
        rivals: [
            { ok: true, note: 'Yes' },
            { ok: true, note: 'Yes' },
            { ok: false, note: 'iCloud & Google Drive only' },
        ],
    },
    {
        label: 'Updated in November 2026',
        keeforge: '22 Nov 2026',
        rivals: [
            { ok: false, note: '19 Nov 2025' },
            { ok: false, note: '1 Sep 2026' },
            { ok: true, note: '14 Nov 2026' },
        ],
    },
];

const strengths = [
    'Every feature free. No subscription, no paid tier, no database limit.',
    'Passkeys, 2FA codes and passwords in AutoFill, with Face ID.',
    'Open source under GPLv3. No account, no tracking.',
    'One app for iPhone, iPad and a native Mac app.',
];

// Each cell is plain text; links to the sources live in the Sources section.
const apps = ['KeeForge', 'KeePassium', 'Strongbox', 'PanicVault', 'OneKeePass'];
const rows: { label: string; cells: string[] }[] = [
    {
        label: 'Price on iPhone',
        cells: [
            'Free. Optional tip jar.',
            'Free for one database. Premium €19.99/year (rent-to-own) or Pro €79.99 once.',
            'Free for non-commercial use. Pro $2.99/month, $24.99/year or $124.99 lifetime (website prices).',
            '$4.99 once (US App Store). No free version.',
            'Free.',
        ],
    },
    {
        label: 'Paid features',
        cells: [
            'None.',
            'More than one database, YubiKey, Quick AutoFill, password audit, linked databases, business cloud accounts.',
            'On iPhone: Face ID / Touch ID unlock, offline editing, YubiKey, Apple Watch. On Mac, AutoFill, passkeys, SFTP and WebDAV are also Pro.',
            'None after purchase.',
            'None.',
        ],
    },
    {
        label: 'Source code',
        cells: [
            'Open source, GPLv3, whole app.',
            'Open source, GPLv3.',
            'Published under AGPL-3.0, but the project calls itself "source available": no build path, and code drops lag releases.',
            'Closed source.',
            'Open source, GPLv3.',
        ],
    },
    {
        label: 'Apple platforms',
        cells: [
            'iPhone, iPad, Mac (native Mac app).',
            'iPhone, iPad, Mac (Mac Catalyst), Vision Pro.',
            'iPhone, iPad, Mac, Apple Watch, Vision Pro.',
            'iPhone, iPad, Mac, Vision Pro.',
            'iPhone, iPad. Desktop apps for Mac, Windows and Linux, plus Android.',
        ],
    },
    {
        label: 'Minimum iOS',
        cells: ['iOS 18', 'iOS 17', 'iOS 15', 'iOS 17.6', 'iOS 15.1'],
    },
    {
        label: 'Database formats',
        cells: [
            'KDBX 4 read and write. KDBX 3.1 read-only.',
            'KDBX 4, KDBX 3 and KeePass 1 (.kdb).',
            'KDBX 4.1, 4.0 and 3.1, KeePass 1 (.kdb), and Password Safe 3.',
            'KDBX 4 only. Older files must be upgraded first.',
            'KDBX 4.',
        ],
    },
    {
        label: 'Password AutoFill',
        cells: ['Yes', 'Yes', 'Yes', 'Yes', 'Yes'],
    },
    {
        label: 'Passkeys',
        cells: [
            'Yes, in AutoFill. KeePassXC-compatible.',
            'Yes, in AutoFill. KeePassXC-compatible.',
            'Yes (free on iPhone, Pro on Mac).',
            'Stores KeePassXC-format passkeys. iPhone passkey AutoFill not documented.',
            'Yes, on iOS 17 and later.',
        ],
    },
    {
        label: '2FA (TOTP) codes',
        cells: [
            'Yes, including AutoFill on iOS 18 and Mac.',
            'Yes, including AutoFill on iOS 18.',
            'Yes.',
            'Yes, in the app. The Mac browser extension fills them.',
            'Yes, including AutoFill.',
        ],
    },
    {
        label: 'Built-in sync',
        cells: [
            'iPhone and iPad: Dropbox, OneDrive, WebDAV, FTP, plus iCloud Drive and other Files providers. Mac: WebDAV, FTP and synced folders.',
            'Dropbox, Google Drive, OneDrive, WebDAV, plus iCloud Drive and other Files providers.',
            'iCloud, Dropbox, OneDrive, Google Drive, WebDAV, SFTP, plus Files providers. SharePoint is Pro.',
            'iCloud Drive and Google Drive.',
            'SFTP, WebDAV, plus Files providers.',
        ],
    },
    {
        label: 'Key files',
        cells: ['Yes, and can create them', 'Yes, and can create them', 'Yes', 'Yes', 'Yes, and can create them'],
    },
    {
        label: 'YubiKey',
        cells: [
            'Read-only, on iPhone over NFC.',
            'Paid. Lightning, NFC on iPhone, USB on Mac.',
            'Pro. USB-C keys not supported on iOS.',
            'NFC on iPhone, USB on Mac. Not on iPad.',
            'Not documented.',
        ],
    },
    {
        label: 'Independent security audit',
        cells: [
            'None.',
            'Yes: Cure53, October 2024.',
            'No code-level audit, per Strongbox. Yearly CASA Tier 2 assessment.',
            'None published.',
            'None published.',
        ],
    },
    {
        label: 'App languages',
        cells: ['9', '20', '18', '1 (English)', '1 (English)'],
    },
    {
        label: 'Latest App Store update (US)',
        cells: ['1.23.0, 22 Nov 2026', '2.5, 19 Nov 2025', '1.65.2, 1 Sep 2026', '1.1.7, 14 Nov 2026', '0.25.0, 18 Nov 2026'],
    },
];

const sources: { group: string; links: { label: string; href: string }[] }[] = [
    {
        group: 'KeeForge',
        links: [
            { label: 'README (features, sync, formats)', href: 'https://github.com/KeeForge/KeeForge/blob/main/README.md' },
            { label: 'Changelog (1.23.0 release, YubiKey support)', href: 'https://github.com/KeeForge/KeeForge/blob/main/CHANGELOG.md' },
            { label: 'GPLv3 license', href: 'https://github.com/KeeForge/KeeForge/blob/main/LICENSE' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6759309295' },
        ],
    },
    {
        group: 'KeePassium',
        links: [
            { label: 'Pricing and free vs paid comparison', href: 'https://keepassium.com/pricing/' },
            { label: 'Security audits (Cure53, CASA)', href: 'https://support.keepassium.com/kb/security-audits/' },
            { label: 'Cure53 audit report, October 2024 (PDF)', href: 'https://keepassium.com/audit/2024-10-Cure53.pdf' },
            { label: 'Sync options', href: 'https://support.keepassium.com/kb/sync/' },
            { label: 'YubiKey compatibility', href: 'https://support.keepassium.com/kb/yubikey-compatibility/' },
            { label: 'KeePassium 2.0: passkeys, Mac app, 2FA AutoFill', href: 'https://keepassium.com/blog/2024/12/keepassium-2.0/' },
            { label: 'Source code', href: 'https://github.com/keepassium/KeePassium' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id1435127111' },
        ],
    },
    {
        group: 'Strongbox',
        links: [
            { label: 'Free vs Pro comparison', href: 'https://strongboxsafe.com/comparison/' },
            { label: 'Pro pricing', href: 'https://strongboxsafe.com/pricing/' },
            { label: 'Supported KeePass versions', href: 'https://strongbox.reamaze.com/kb/faqs/what-version-of-keepass-does-strongbox-support' },
            { label: 'Statement on security audits', href: 'https://strongbox.reamaze.com/kb/security-and-privacy/security-audit' },
            { label: 'Strongbox joins Applause (March 2025)', href: 'https://strongboxsafe.com/strongbox-joins-applause/' },
            { label: 'Source code and license notes', href: 'https://github.com/strongbox-password-safe/Strongbox' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id897283731' },
        ],
    },
    {
        group: 'PanicVault',
        links: [
            { label: 'Homepage', href: 'https://panicvault.org/' },
            { label: 'User manual', href: 'https://www.panicvault.org/help/' },
            { label: 'PanicVault’s own KeePass for iPhone guide', href: 'https://www.panicvault.org/keepass/keepass-ios/' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6759188575' },
        ],
    },
    {
        group: 'OneKeePass',
        links: [
            { label: 'Homepage', href: 'https://onekeepass.com/' },
            { label: 'Mobile source code', href: 'https://github.com/onekeepass/mobile' },
            { label: 'App Store listing', href: 'https://apps.apple.com/app/id6448712640' },
        ],
    },
    {
        group: 'KeePassXC',
        links: [
            { label: 'FAQ: “Does KeePassXC work on mobile phones?”', href: 'https://keepassxc.org/docs/' },
        ],
    },
];
---

<Page
    lang="en"
    enPath={path}
    canonicalPath={path}
    ogType="article"
    title={title}
    description={description}
    eyebrow={`Best KeePass app for iPhone · Checked ${checked}`}
    heading="Our pick: KeeForge."
    headingAccent="Every feature, free."
    lead="The KeePass app for iPhone, iPad and Mac with nothing locked behind a paywall."
>
    <div class="verdict-hero" slot="hero">
        <ul class="strengths">
            {strengths.map((item) => <li>{item}</li>)}
        </ul>
        <DownloadLinks labels={home.en.downloads} id="download" />
    </div>

    <section class="verdict" aria-labelledby="verdict-title">
        <h2 id="verdict-title">KeeForge vs the popular alternatives</h2>
        <div class="verdict-wrap">
            <table class="verdict-table">
                <thead>
                    <tr>
                        <th scope="col"><span class="visually-hidden">Feature</span></th>
                        <th scope="col" class="us"><Fragment set:html={wrapName('KeeForge')} /></th>
                        {rivals.map((rival) => <th scope="col"><Fragment set:html={wrapName(rival)} /></th>)}
                    </tr>
                </thead>
                <tbody>
                    {verdict.map((row) => (
                        <tr>
                            <th scope="row">{row.label}</th>
                            <td class="us"><span class="mark yes" aria-label="Yes">✓</span><span class="note">{row.keeforge}</span></td>
                            {row.rivals.map((cell) => (
                                <td><span class={`mark ${cell.ok ? 'yes' : 'no'}`} aria-label={cell.ok ? 'Yes' : 'No'}>{cell.ok ? '✓' : '✕'}</span><span class="note">{cell.note}</span></td>
                            ))}
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </section>

    <section class="details" id="details">
        <details>
            <summary>Full comparison and sources <span aria-hidden="true" class="faq-symbol"></span></summary>
            <div class="details-body">
                <h3>All five apps, side by side</h3>
                <div class="vs-table-wrap" tabindex="0" role="region" aria-label="KeePass apps for iPhone compared">
                    <table class="vs-table wide">
                        <thead>
                            <tr>
                                <th scope="col"><span class="visually-hidden">Feature</span></th>
                                {apps.map((app) => <th scope="col">{app}</th>)}
                            </tr>
                        </thead>
                        <tbody>
                            {rows.map((row) => (
                                <tr>
                                    <th scope="row">{row.label}</th>
                                    {row.cells.map((cell) => <td>{cell}</td>)}
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>

                <h3>Coming from KeePassXC?</h3>
                <p>KeePassXC has no iPhone app; its FAQ suggests Strongbox and KeePassium. KeeForge opens KeePassXC’s KDBX 4 databases and reads its passkeys. Put the file in iCloud Drive, Dropbox, OneDrive or on a WebDAV server and add it in KeeForge.</p>

                <h3 id="sources">Sources</h3>
                <p>Opened and checked on {checked}. App versions and dates are from the US App Store.</p>
                <div class="sources">
                    {sources.map((group) => (
                        <div>
                            <h4>{group.group}</h4>
                            <ul>
                                {group.links.map((link) => <li><a href={link.href} rel="noopener">{link.label}</a></li>)}
                            </ul>
                        </div>
                    ))}
                </div>
                <p class="compare-links">
                    <a href="/vs/keepassium/">KeeForge / KeePassium <span aria-hidden="true">↗</span></a>
                    <a href="/vs/strongbox/">KeeForge / Strongbox <span aria-hidden="true">↗</span></a>
                </p>
            </div>
        </details>
    </section>
</Page>
