<script>
    // Scroll-triggered reveal
    const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
            (entries, obs) => {
                for (const e of entries) {
                    if (e.isIntersecting) {
                        const el = e.target as HTMLElement;
                        const delay = parseInt(el.dataset.revealDelay || '0', 10);
                        const y = el.dataset.revealY;
                        if (y) el.style.setProperty('--kf-reveal-y', `${y}px`);
                        setTimeout(() => el.classList.add('is-revealed'), delay);
                        obs.unobserve(el);
                    }
                }
            },
            { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => {
            const y = el.dataset.revealY;
            if (y) el.style.transform = `translateY(${y}px)`;
            io.observe(el);
        });
    } else {
        revealEls.forEach((el) => el.classList.add('is-revealed'));
    }

    // Parallax
    const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
    let ticking = false;
    function onParallaxScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
            const vh = window.innerHeight;
            for (const el of parallaxEls) {
                const rect = el.getBoundingClientRect();
                const speed = parseFloat(el.dataset.parallax || '0');
                const center = rect.top + rect.height / 2;
                const dist = center - vh / 2;
                el.style.transform = `translateY(${-dist * speed}px)`;
            }
            ticking = false;
        });
    }
    if (parallaxEls.length) {
        window.addEventListener('scroll', onParallaxScroll, { passive: true });
        onParallaxScroll();
    }

    // FAQ accordion (single-open)
    const faqItems = Array.from(document.querySelectorAll<HTMLElement>('.kf-faq-item'));
    faqItems.forEach((item) => {
        const btn = item.querySelector<HTMLButtonElement>('.kf-faq-q');
        if (!btn) return;
        btn.addEventListener('click', () => {
            const isOpen = item.classList.contains('kf-faq-open');
            faqItems.forEach((other) => {
                other.classList.remove('kf-faq-open');
                other.querySelector('.kf-faq-q')?.setAttribute('aria-expanded', 'false');
            });
            if (!isOpen) {
                item.classList.add('kf-faq-open');
                btn.setAttribute('aria-expanded', 'true');
            }
        });
    });

    // Typing README
    const typingEl = document.querySelector<HTMLElement>('[data-typing]');
    if (typingEl) {
        let lines: Array<[string, string]> = [];
        try {
            lines = JSON.parse(typingEl.dataset.lines || '[]');
        } catch (_) {}
        typingEl.innerHTML = '';
        const caret = document.createElement('span');
        caret.className = 'kf-readme-caret';
        typingEl.appendChild(caret);

        let step = 0;
        let started = false;
        const advance = () => {
            if (step >= lines.length) {
                caret.remove();
                return;
            }
            const [kind, text] = lines[step];
            const div = document.createElement('div');
            div.className = 'kf-readme-line ' + (kind === 'h' ? 'kf-readme-line-h' : kind === 't' ? 'kf-readme-line-t' : '');
            div.textContent = text;
            typingEl.insertBefore(div, caret);
            step++;
            setTimeout(advance, 140);
        };
        if ('IntersectionObserver' in window) {
            const tio = new IntersectionObserver(
                (entries, obs) => {
                    for (const e of entries) {
                        if (e.isIntersecting && !started) {
                            started = true;
                            advance();
                            obs.disconnect();
                        }
                    }
                },
                { threshold: 0.3 }
            );
            tio.observe(typingEl);
        } else {
            advance();
        }
    }
</script>
