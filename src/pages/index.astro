---
import Base from '../layouts/Base.astro';

const trustPills = [
    { k: '01', t: 'Open source', d: 'GPL 3.0. Audit every line.' },
    { k: '02', t: 'KeePass compatible', d: 'Reads & writes standard .kdbx files.' },
    { k: '03', t: 'Free, forever', d: 'No subscription, no ads, no upsells.' },
    { k: '04', t: 'Face ID + AutoFill', d: 'Fills credentials across every app.' },
];

const features = [
    {
        eyebrow: 'MANY VAULTS',
        title: 'One home screen for every database you have.',
        body: 'Drop your .kdbx files in from Files, Dropbox, or iCloud Drive. KeeForge keeps them side by side so switching between Personal, Work, and Shared takes a single tap.',
        points: [
            'Open as many databases as you like, locally or from the cloud',
            'Each vault remembers its own unlock state and key file',
            'Tap-to-switch — no closing one to open another',
        ],
        screen: 'screen-01-database-list.png',
        reverse: false,
    },
    {
        eyebrow: 'ORGANIZE & FIND',
        title: 'Groups, search, and the entry detail you’d expect.',
        body: 'Browse by folder the way you set up your vault on the desktop. Search every field across every group. Open an entry to copy, reveal, or jump to the URL.',
        points: [
            'Hierarchical groups, just like KeePassXC',
            'Full-text search with results count and instant filtering',
            'Reveal passwords with a tap, copy with another',
        ],
        screen: 'screen-03-vault-groups.png',
        reverse: true,
    },
    {
        eyebrow: 'EDIT ON DEVICE',
        title: 'Create and edit entries without leaving your phone.',
        body: 'The full edit sheet: title, username, password, URL, tags, and notes. Generate a strong password with one tap. Save back to the .kdbx, encrypted, the moment you hit done.',
        points: [
            'Built-in generator, configurable like the desktop client',
            'Edits write back to the source file — nothing forked or proxied',
            'Read-only mode per database when you want it safe',
        ],
        screen: 'screen-07-entry-edit.png',
        reverse: false,
    },
];

const compareCards = [
    {
        title: 'vs iCloud Keychain',
        bullets: [
            'KeePass <code class="mono">.kdbx</code> vaults work with desktop tools (KeePassXC, KeePass 2.x) and across non-Apple devices.',
            'Your encrypted database is portable — back it up locally, sync via Dropbox or OneDrive, or store offline.',
            'Open source code you can audit, with no telemetry of any kind.',
        ],
    },
    {
        title: 'vs 1Password & Bitwarden',
        bullets: [
            'No subscription, no account, no vendor lock-in. Your vault is a file on your device or your own cloud.',
            'Compatible with the open KeePass ecosystem — KeePassXC, Strongbox, KeePassium, Keepass2Android.',
            'GPLv3 open source. Every line is auditable, with zero analytics or telemetry.',
        ],
    },
    {
        title: 'vs other iOS KeePass clients',
        bullets: [
            'Native Swift, built for iOS 17+ with current platform features (passkeys, TOTP AutoFill, Files integration).',
            'Free forever, all features included — no premium tier, no in-app paywalls (just an optional tip jar).',
            'Saves are conflict-detected and auto-backed-up; AutoFill works offline for cloud-backed vaults.',
        ],
    },
];

const faqItems = [
    { q: 'Is KeeForge really free?', a: 'Yes — free on the App Store, no subscriptions, no ads, no premium tier. If you’d like to support development, star the repo or buy me a coffee.' },
    { q: 'Does it work with my existing KeePass database?', a: 'Any .kdbx file from KeePass 2.x, KeePassXC, or any other compatible client opens directly. Read and write are both supported.' },
    { q: 'Where are my passwords stored?', a: 'On your device. KeeForge has no server. Sync is your choice: iCloud Drive, Dropbox, or anything you can put a file into.' },
    { q: 'How does AutoFill work?', a: 'KeeForge registers as an iOS Credential Provider. Tap a login field anywhere, choose KeeForge, authenticate with Face ID, and your credentials are filled.' },
    { q: 'Can I trust it?', a: 'Read the code. Build it yourself. Or trust the App Store review process plus a public commit history — that’s more than most password managers offer.' },
];
---

<Base>
    <div class="kf-root">
        <!-- Nav -->
        <header class="kf-nav">
            <div class="kf-nav-inner">
                <a href="/" class="kf-brand">
                    <span class="kf-keymark" aria-hidden="true"></span>
                    <span class="kf-brand-name">KeeForge</span>
                </a>
                <nav class="kf-nav-links">
                    <a href="#features">Features</a>
                    <a href="#open">Open source</a>
                    <a href="#faq">FAQ</a>
                    <a href="https://github.com/crazytan/KeeForge/blob/main/CHANGELOG.md" rel="noopener">Changelog</a>
                </nav>
                <div class="kf-nav-cta">
                    <a href="https://github.com/crazytan/KeeForge" rel="noopener" class="kf-nav-source">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                        <span>Source</span>
                    </a>
                    <a href="https://apps.apple.com/us/app/keeforge/id6759309295" class="kf-btn kf-btn-pill">
                        <svg viewBox="0 0 17 20" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M14.83 6.42c-.1.08-1.92 1.1-1.92 3.38 0 2.64 2.31 3.57 2.38 3.6-.01.06-.37 1.28-1.22 2.52-.76 1.1-1.55 2.19-2.75 2.19-1.2 0-1.51-.7-2.9-.7-1.35 0-1.83.73-2.93.73-1.1 0-1.87-1.01-2.75-2.26C1.7 13.93 1 11.59 1 9.38c0-3.54 2.3-5.42 4.57-5.42 1.2 0 2.21.79 2.96.79.72 0 1.84-.84 3.22-.84.52 0 2.34.05 3.08 2.51zM10.65 2.35c.57-.68.97-1.62.97-2.56 0-.13-.01-.26-.03-.37-.93.04-2.03.62-2.7 1.4-.52.6-1 1.55-1 2.5 0 .14.02.29.03.34.06.01.16.02.26.02.83 0 1.88-.56 2.47-1.33z"/></svg>
                        App Store
                    </a>
                </div>
            </div>
        </header>

        <!-- Hero -->
        <section class="kf-hero">
            <div class="kf-flourish" data-parallax="0.04" aria-hidden="true">✱</div>
            <div class="kf-hero-grid">
                <div class="kf-hero-copy">
                    <h1 data-reveal data-reveal-delay="80">
                        A KeePass app<br>
                        that feels at <em>home</em> on&nbsp;iOS.
                    </h1>
                    <p class="kf-hero-lead" data-reveal data-reveal-delay="160">
                        KeeForge opens your existing <code class="mono">.kdbx</code> vaults
                        with Face&nbsp;ID, fills passwords across every app, and never asks
                        for a subscription. It just lives on your phone, the way good tools do.
                    </p>
                    <div class="kf-hero-cta" data-reveal data-reveal-delay="220">
                        <a href="https://apps.apple.com/us/app/keeforge/id6759309295" class="kf-btn kf-btn-appstore">
                            <svg viewBox="0 0 17 20" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M14.83 6.42c-.1.08-1.92 1.1-1.92 3.38 0 2.64 2.31 3.57 2.38 3.6-.01.06-.37 1.28-1.22 2.52-.76 1.1-1.55 2.19-2.75 2.19-1.2 0-1.51-.7-2.9-.7-1.35 0-1.83.73-2.93.73-1.1 0-1.87-1.01-2.75-2.26C1.7 13.93 1 11.59 1 9.38c0-3.54 2.3-5.42 4.57-5.42 1.2 0 2.21.79 2.96.79.72 0 1.84-.84 3.22-.84.52 0 2.34.05 3.08 2.51zM10.65 2.35c.57-.68.97-1.62.97-2.56 0-.13-.01-.26-.03-.37-.93.04-2.03.62-2.7 1.4-.52.6-1 1.55-1 2.5 0 .14.02.29.03.34.06.01.16.02.26.02.83 0 1.88-.56 2.47-1.33z"/></svg>
                            <span class="kf-btn-stack">
                                <span class="kf-btn-tiny">Download on the</span>
                                <span class="kf-btn-big">App Store</span>
                            </span>
                        </a>
                        <a href="https://github.com/crazytan/KeeForge" rel="noopener" class="kf-btn kf-btn-ghost">
                            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                            Read the source
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                        </a>
                    </div>
                    <div class="kf-hero-meta" data-reveal data-reveal-delay="280">
                        <span>iOS 17 +</span>
                        <span class="kf-dot"></span>
                        <span>iPhone &amp; iPad</span>
                        <span class="kf-dot"></span>
                        <span>KDBX 3.1 / 4.0</span>
                        <span class="kf-dot"></span>
                        <span>No tracking, ever</span>
                    </div>
                </div>
                <div class="kf-hero-phone-wrap" data-parallax="0.08">
                    <div class="kf-hero-halo" aria-hidden="true"></div>
                    <div data-reveal data-reveal-y="40" data-reveal-delay="100">
                        <div class="kf-phone kf-phone-hero">
                            <div class="kf-phone-screen">
                                <img src="/screenshots/screen-01-database-list.png" alt="KeeForge database list screen" width="320" height="693" />
                                <span class="kf-phone-island"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust -->
        <section class="kf-trust">
            <div class="kf-trust-grid">
                {trustPills.map((p, i) => (
                    <div class="kf-trust-cell" data-reveal data-reveal-delay={i * 80} data-reveal-y="20">
                        <div class="kf-trust-k mono">{p.k}</div>
                        <div class="kf-trust-t">{p.t}</div>
                        <div class="kf-trust-d">{p.d}</div>
                    </div>
                ))}
            </div>
        </section>

        <!-- Features -->
        {features.map((f, i) => (
            <section class={`kf-feature${f.reverse ? ' kf-feature-reverse' : ''}`} id={i === 0 ? 'features' : undefined}>
                <div class="kf-feature-grid">
                    <div class="kf-feature-copy">
                        <div class="kf-eyebrow mono" data-reveal>{String(i + 1).padStart(2, '0')} · {f.eyebrow}</div>
                        <h2 data-reveal data-reveal-delay="80">{f.title}</h2>
                        <p data-reveal data-reveal-delay="140">{f.body}</p>
                        <ul data-reveal data-reveal-delay="200">
                            {f.points.map((p) => (
                                <li><span class="kf-dash"></span>{p}</li>
                            ))}
                        </ul>
                    </div>
                    <div class="kf-feature-phone-wrap">
                        <div data-reveal data-reveal-y="40" data-reveal-delay="100">
                            <div class="kf-feature-phone-bg" data-reveal-bg></div>
                            <div class="kf-phone kf-phone-feature">
                                <div class="kf-phone-screen">
                                    <img src={`/screenshots/${f.screen}`} alt="" width="280" height="606" loading="lazy" />
                                    <span class="kf-phone-island"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ))}

        <!-- Compare -->
        <section class="kf-compare">
            <div class="kf-compare-head">
                <div class="kf-eyebrow mono" data-reveal>HOW IT COMPARES</div>
                <h2 data-reveal data-reveal-delay="80">
                    Already using a password manager? <em>Here’s where KeeForge fits.</em>
                </h2>
            </div>
            <div class="kf-compare-grid">
                {compareCards.map((c, i) => (
                    <article class="kf-compare-card" data-reveal data-reveal-delay={i * 100} data-reveal-y="32">
                        <div class="kf-compare-num mono">{String(i + 1).padStart(2, '0')} / 03</div>
                        <h3>{c.title}</h3>
                        <ul>
                            {c.bullets.map((b) => (
                                <li>
                                    <span class="kf-bullet-dot"></span>
                                    <div set:html={b}></div>
                                </li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
        </section>

        <!-- Open source -->
        <section class="kf-open" id="open">
            <div class="kf-open-grid">
                <div class="kf-open-copy">
                    <div class="kf-eyebrow mono kf-eyebrow-gold" data-reveal>BUILT IN THE OPEN</div>
                    <h2 data-reveal data-reveal-delay="80">
                        One developer.<br>
                        <em>Public</em> commit history.
                    </h2>
                    <p data-reveal data-reveal-delay="140">
                        KeeForge is built by one person, in the open, on GitHub. File an issue, send a pull request,
                        or just read the code before you trust it with your secrets — that’s the whole point.
                    </p>
                    <div class="kf-open-cta" data-reveal data-reveal-delay="200">
                        <a href="https://github.com/crazytan/KeeForge" rel="noopener" class="kf-btn kf-btn-gold">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-1.96c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                            crazytan / KeeForge
                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                        </a>
                    </div>
                </div>
                <div class="kf-readme" data-reveal data-reveal-y="30" data-reveal-delay="120">
                    <div class="kf-readme-head">
                        <span class="kf-readme-dot kf-readme-r"></span>
                        <span class="kf-readme-dot kf-readme-y"></span>
                        <span class="kf-readme-dot kf-readme-g"></span>
                        <span class="kf-readme-label mono">README.md</span>
                    </div>
                    <div class="kf-readme-body mono" data-typing data-lines='[
                        ["h", "# KeeForge"],
                        ["b", " "],
                        ["t", "A native iOS client for KeePass"],
                        ["t", "databases. SwiftUI, no servers,"],
                        ["t", "no telemetry."],
                        ["b", " "],
                        ["h", "## Features"],
                        ["t", "- Open .kdbx files locally"],
                        ["t", "- Sync via Dropbox or Files"],
                        ["t", "- Face ID / Touch ID unlock"],
                        ["t", "- iOS AutoFill provider"],
                        ["b", " "],
                        ["h", "## License"],
                        ["t", "GPL-3.0"]
                    ]'></div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="kf-faq" id="faq">
            <div class="kf-faq-grid">
                <div class="kf-faq-head">
                    <div class="kf-eyebrow mono" data-reveal>FAQ</div>
                    <h2 data-reveal data-reveal-delay="80">Questions,<br>answered plainly.</h2>
                </div>
                <div class="kf-faq-list">
                    {faqItems.map((item, i) => (
                        <div class="kf-faq-item" data-reveal data-reveal-delay={i * 60}>
                            <button class="kf-faq-q" type="button" aria-expanded="false">
                                <h3>{item.q}</h3>
                                <span class="kf-faq-plus" aria-hidden="true">+</span>
                            </button>
                            <div class="kf-faq-a">
                                <p>{item.a}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="kf-foot">
            <div class="kf-foot-inner">
                <div class="kf-foot-brand">
                    <span class="kf-keymark kf-keymark-sm" aria-hidden="true"></span>
                    <span class="kf-foot-name">KeeForge</span>
                    <span class="kf-foot-copy">© 2026 · GPL 3.0 · Made by one person</span>
                </div>
                <div class="kf-foot-links">
                    <a href="/privacy">Privacy</a>
                    <a href="mailto:support@keeforge.com">Support</a>
                </div>
            </div>
        </footer>
    </div>
</Base>

<style is:global>
    body { background: #F2EADA; }
    html { scroll-behavior: smooth; }
    @keyframes kfBlink { 50% { opacity: 0; } }
</style>
<noscript><style>[data-reveal]{opacity:1!important;transform:none!important}</style></noscript>

<style>
    .kf-root {
        --kf-bg: #F2EADA;
        --kf-bg-alt: #E9DFC8;
        --kf-paper: #FBF5E7;
        --kf-ink: #26201A;
        --kf-ink-soft: #5C5044;
        --kf-ink-mute: #8A7C6B;
        --kf-rule: #D8CCB1;
        --kf-gold: #D8A03C;
        --kf-navy: #3A4479;
        --kf-accent: #BD5A3A;
        --kf-accent-deep: #8E3F25;
        --kf-serif: 'Newsreader', Georgia, serif;
        --kf-sans: 'Instrument Sans', system-ui, -apple-system, sans-serif;
        --kf-mono: 'JetBrains Mono', ui-monospace, monospace;
        background: var(--kf-bg);
        color: var(--kf-ink);
        font-family: var(--kf-sans);
        min-height: 100vh;
        font-feature-settings: "ss01", "ss02";
    }

    .kf-root .mono { font-family: var(--kf-mono); }
    .kf-root code { font-family: var(--kf-mono); }

    [data-reveal] {
        opacity: 0;
        transform: translateY(26px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }
    [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
    }

    /* ── Key mark ────────────────────────────────────────────────────── */
    .kf-keymark {
        width: 34px; height: 34px;
        border-radius: 8px;
        background: var(--kf-navy);
        display: inline-block;
        position: relative;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
        flex-shrink: 0;
    }
    .kf-keymark::after {
        content: "";
        position: absolute;
        inset: 11%;
        background: var(--kf-gold);
        -webkit-mask: url("/keeforge-key.svg") center/contain no-repeat;
        mask: url("/keeforge-key.svg") center/contain no-repeat;
    }
    .kf-keymark-sm { width: 22px; height: 22px; border-radius: 6px; }

    /* ── Nav ─────────────────────────────────────────────────────────── */
    .kf-nav {
        position: sticky; top: 0; z-index: 50;
        background: rgba(242, 234, 218, 0.9);
        backdrop-filter: saturate(1.4) blur(14px);
        -webkit-backdrop-filter: saturate(1.4) blur(14px);
        border-bottom: 1px solid var(--kf-rule);
        padding: 18px clamp(24px, 5vw, 56px);
    }
    .kf-nav-inner {
        max-width: 1280px; margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        gap: 24px;
    }
    .kf-brand {
        display: inline-flex; align-items: center; gap: 10px;
        text-decoration: none; color: var(--kf-ink);
    }
    .kf-brand-name {
        font-family: var(--kf-serif);
        font-size: 22px; font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--kf-ink);
    }
    .kf-nav-links {
        display: flex; align-items: center; gap: 32px;
        font-size: 14.5px; color: var(--kf-ink-soft);
    }
    .kf-nav-links a {
        color: inherit; text-decoration: none; transition: color 0.2s;
    }
    .kf-nav-links a:hover { color: var(--kf-ink); }
    .kf-nav-cta {
        display: flex; align-items: center; gap: 12px; font-size: 14.5px;
    }
    .kf-nav-source {
        display: inline-flex; align-items: center; gap: 8px;
        color: var(--kf-ink-soft); text-decoration: none; transition: color 0.2s;
    }
    .kf-nav-source:hover { color: var(--kf-ink); }

